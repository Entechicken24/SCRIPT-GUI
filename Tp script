end)

-- TELEPORT BACK
connect(backButton.Activated, function()
    if busy then return end

    local myRoot = getRoot(LocalPlayer)
    if not myRoot or not lastPosition then
        countLabel.Text = "NO PREVIOUS LOCATION"
        return
    end

    busy = true

    local destination = lastPosition
    lastPosition = myRoot.CFrame
    myRoot.CFrame = destination

    countLabel.Text = "RETURNED TO LAST LOCATION"

    task.delay(0.35, function()
        busy = false
    end)
end)

