if old then old:Destroy() end
local favorites = {}
local friends = {}
local selectedPlayer
local previousCFrame
local loopActive = false
local loopConnection
local FOLLOW_OFFSET = CFrame.new(3, 0, 0)
local function make(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end
local function round(obj, radius)
    make("UICorner", {
        CornerRadius = UDim.new(0, radius)
    }, obj)
end
local function outline(obj)
    make("UIStroke", {
        Color = Color3.fromRGB(65, 65, 65),
        Thickness = 1
    }, obj)
end
local gui = make("ScreenGui", {
    Name = "SimpleTeleportHub",
    ResetOnSpawn = false,
    IgnoreGuiInset = true
}, PlayerGui)
local function draggable(frame, handle)
    local active
    local startPos
    local originalPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            active = true
            startPos = input.Position
            originalPos = frame.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if active and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            local delta = input.Position - startPos
            frame.Position = UDim2.new(
                originalPos.X.Scale,
                originalPos.X.Offset + delta.X,
                originalPos.Y.Scale,
                originalPos.Y.Offset + delta.Y
            )
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            active = false
        end
    end)
end
