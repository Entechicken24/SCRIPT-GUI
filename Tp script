local function connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(connections, connection)
    return connection
end

local function create(className, props, parent)
    local obj = Instance.new(className)
    for key, value in pairs(props or {}) do
        obj[key] = value
    end
    obj.Parent = parent
    return obj
end

local function round(obj, radius)
    create("UICorner", {
        CornerRadius = UDim.new(0, radius or 9)
    }, obj)
end

local function outline(obj, color)
    return create("UIStroke", {
        Color = color or BORDER,
        Thickness = 1,
        Transparency = 0
    }, obj)
end

local function animate(obj, duration, props)
    local t = TweenService:Create(
        obj,
        TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        props
    )
    t:Play()
    return t
end

local function makeButton(parent, text, size, position)
    local button = create("TextButton", {
        Size = size,
        Position = position,
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = TEXT,
        TextSize = 12,
        Font = Enum.Font.GothamSemibold,
        AutoButtonColor = false
    }, parent)

    round(button, 8)
    outline(button)

    connect(button.MouseEnter, function()
        animate(button, 0.12, {BackgroundColor3 = HOVER})
    end)

    connect(button.MouseLeave, function()
        animate(button, 0.12, {BackgroundColor3 = PANEL})
    end)

    return button
end

