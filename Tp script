local rebuilding = false
local rebuildPending = false
local function stopLoop()
    loopActive = false
    if loopConnection then
        loopConnection:Disconnect()
        loopConnection = nil
    end
    loop.Text = "START FOLLOW TP"
end
local function getRoots(player)
    local character = Me.Character
    local targetCharacter = player and player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local targetRoot = targetCharacter
        and targetCharacter:FindFirstChild("HumanoidRootPart")
    return root, targetRoot
end
local function teleportOnce(player)
    local root, targetRoot = getRoots(player)
    if not root or not targetRoot then
        status.Text = "Character not available"
        return false
    end
    if not previousCFrame then
        previousCFrame = root.CFrame
    end
    root.CFrame = targetRoot.CFrame * FOLLOW_OFFSET
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    return true
end
local function startFollow(player)
    stopLoop()
    if not player or player.Parent ~= Players then
        status.Text = "Player not available"
        return
    end
    local root, targetRoot = getRoots(player)
    if not root or not targetRoot then
        status.Text = "Character not available"
        return
    end
    if not previousCFrame then
        previousCFrame = root.CFrame
    end
    loopActive = true
    loop.Text = "STOP FOLLOW TP"
    status.Text = "Following " .. player.Name
    loopConnection = RunService.Heartbeat:Connect(function()
        if not loopActive then
            return
        end
        if not selectedPlayer
        or selectedPlayer ~= player
        or player.Parent ~= Players then
            stopLoop()
            status.Text = "Follow stopped"
            return
        end
        local currentRoot, currentTargetRoot = getRoots(player)
        if not currentRoot or not currentTargetRoot then
            status.Text = "Waiting for character..."
            return
        end
        -- Keeps the local character attached to the target.
        currentRoot.CFrame = currentTargetRoot.CFrame * FOLLOW_OFFSET
        currentRoot.AssemblyLinearVelocity = Vector3.zero
        currentRoot.AssemblyAngularVelocity = Vector3.zero
    end)
end
local function rebuild()
    if rebuilding then
        rebuildPending = true
        return
    end
    rebuilding = true
    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    local query = string.lower(search.Text)
    local candidates = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Me then
            if friends[player.UserId] == nil then
                friends[player.UserId] = false
                task.spawn(function()
                    local ok, result = pcall(function()
                        return Me:IsFriendsWith(player.UserId)
                    end)
                    if player.Parent == Players then
                        friends[player.UserId] = ok and result == true
                        task.defer(rebuild)
                    end
                end)
            end
            if string.find(string.lower(player.Name), query, 1, true)
            or string.find(string.lower(player.DisplayName), query, 1, true) then
                table.insert(candidates, player)
            end
        end
    end
    local function rank(player)
        if favorites[player.UserId] then
            return 1
        elseif friends[player.UserId] then
            return 2
        else
            return 3
        end
    end
    table.sort(candidates, function(a, b)
        if rank(a) ~= rank(b) then
            return rank(a) < rank(b)
        end
        return string.lower(a.Name) < string.lower(b.Name)
    end)
    for index, player in ipairs(candidates) do
        local fav = favorites[player.UserId] == true
        local friend = friends[player.UserId] == true
        local row = make("Frame", {
            Size = UDim2.new(1, -2, 0, 45),
            BackgroundColor3 = selectedPlayer == player
                and Color3.fromRGB(48, 48, 48)
                or Color3.fromRGB(29, 29, 29),
            BorderSizePixel = 0,
            LayoutOrder = index
        }, list)
        round(row, 7)
        local avatar = make("ImageLabel", {
            Size = UDim2.fromOffset(32, 32),
            Position = UDim2.fromOffset(6, 6),
            BackgroundTransparency = 1,
            Image = ""
        }, row)
        round(avatar, 16)
        task.spawn(function()
            local ok, image = pcall(function()
                return Players:GetUserThumbnailAsync(
                    player.UserId,
                    Enum.ThumbnailType.HeadShot,
                    Enum.ThumbnailSize.Size48x48
                )
            end)
            if ok and avatar.Parent then
                avatar.Image = image
            end
        end)
        local prefix = fav and "★ " or (friend and "FRIEND • " or "")
        make("TextLabel", {
            Size = UDim2.new(1, -100, 1, 0),
            Position = UDim2.fromOffset(44, 0),
            BackgroundTransparency = 1,
            Text = prefix .. player.DisplayName,
            TextColor3 = friend
                and Color3.fromRGB(140, 210, 160)
                or Color3.new(1, 1, 1),
            TextSize = 11,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd
        }, row)
        local star = make("TextButton", {
            Size = UDim2.fromOffset(34, 34),
            Position = UDim2.new(1, -38, 0, 5),
            BackgroundTransparency = 1,
            Text = fav and "★" or "☆",
            TextColor3 = fav
                and Color3.fromRGB(255, 205, 65)
                or Color3.fromRGB(180, 180, 180),
            TextSize = 22,
            Font = Enum.Font.GothamBold,
            ZIndex = 4
        }, row)
        local selectButton = make("TextButton", {
            Size = UDim2.new(1, -40, 1, 0),
            BackgroundTransparency = 1,
            Text = "",
            ZIndex = 2
        }, row)
        star.Activated:Connect(function()
            favorites[player.UserId] = not favorites[player.UserId]
            rebuild()
        end)
        selectButton.Activated:Connect(function()
            selectedPlayer = player
            status.Text = "Selected: " .. player.Name
            rebuild()
        end)
    end
    rebuilding = false
    if rebuildPending then
        rebuildPending = false
        task.defer(rebuild)
    end
end
tp.Activated:Connect(function()
    if not selectedPlayer then
        status.Text = "Select a player first"
        return
    end
    if teleportOnce(selectedPlayer) then
        status.Text = "Teleported once locally"
    end
end)
loop.Activated:Connect(function()
    if loopActive then
        stopLoop()
        status.Text = "Follow stopped"
        return
    end
    if not selectedPlayer then
        status.Text = "Select a player first"
        return
    end
    startFollow(selectedPlayer)
end)
back.Activated:Connect(function()
    stopLoop()
    local root = Me.Character
        and Me.Character:FindFirstChild("HumanoidRootPart")
    if root and previousCFrame then
        root.CFrame = previousCFrame
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        previousCFrame = nil
        status.Text = "Returned to previous location"
    else
        status.Text = "No saved location"
    end
end)
open.Activated:Connect(function()
    main.Visible = not main.Visible
end)
close.Activated:Connect(function()
    main.Visible = false
end)
search:GetPropertyChangedSignal("Text"):Connect(rebuild)
refresh.Activated:Connect(rebuild)
Players.PlayerAdded:Connect(function(player)
    friends[player.UserId] = nil
    task.defer(rebuild)
end)
Players.PlayerRemoving:Connect(function(player)
    friends[player.UserId] = nil
    if selectedPlayer == player then
        stopLoop()
        selectedPlayer = nil
        status.Text = "Selected player left"
    end
    task.defer(rebuild)
end)
Me.CharacterAdded:Connect(function()
    if loopActive then
        task.wait(0.5)
        if selectedPlayer then
            startFollow(selectedPlayer)
        end
    end
end)
rebuild()
print("SIMPLE TELEPORT HUB loaded")
