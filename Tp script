-- CHARACTER HELPERS
local function getRoot(player)
    local character = player.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

local function teleportTo(player)
    if busy or player == LocalPlayer then return end

    local myRoot = getRoot(LocalPlayer)
    local targetRoot = getRoot(player)

    if not myRoot or not targetRoot then
        countLabel.Text = "CHARACTER NOT READY"
        return
    end

    busy = true
    lastPosition = myRoot.CFrame

    myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
    countLabel.Text = "TELEPORTED TO: " .. player.Name

    task.delay(0.35, function()
        busy = false
    end)
end

-- BUILD PLAYER LIST
local function buildList()
    for _, row in ipairs(rows) do
        if row and row.Parent then
            row:Destroy()
        end
    end
    table.clear(rows)

    local query = string.lower(search.Text)
    local allPlayers = Players:GetPlayers()

    table.sort(allPlayers, function(a, b)
        local aPinned = pinned[a.UserId] == true
        local bPinned = pinned[b.UserId] == true

        if aPinned ~= bPinned then
            return aPinned
        end

        return string.lower(a.Name) < string.lower(b.Name)
    end)

    local shown = 0

    for _, player in ipairs(allPlayers) do
        local matches = query == ""
            or string.find(string.lower(player.Name), query, 1, true)
            or string.find(string.lower(player.DisplayName), query, 1, true)

        if matches then
            shown += 1

            local row = create("Frame", {
                Name = "PlayerRow",
                Size = UDim2.new(1, -2, 0, 56),
                BackgroundColor3 = ROW,
                BorderSizePixel = 0,
                LayoutOrder = shown
            }, list)

            round(row, 8)
            table.insert(rows, row)

            local avatar = create("ImageLabel", {
                Position = UDim2.fromOffset(6, 6),
                Size = UDim2.fromOffset(44, 44),
                BackgroundColor3 = PANEL,
                BorderSizePixel = 0,
                Image = ""
            }, row)

            round(avatar, 22)

            task.spawn(function()
                local success, image = pcall(function()
                    return Players:GetUserThumbnailAsync(
                        player.UserId,
                        Enum.ThumbnailType.HeadShot,
                        Enum.ThumbnailSize.Size100x100
                    )
                end)

                if success and avatar.Parent then
                    avatar.Image = image
                end
            end)

            create("TextLabel", {
                Position = UDim2.fromOffset(57, 8),
                Size = UDim2.new(1, -166, 0, 20),
                BackgroundTransparency = 1,
                Text = player.DisplayName,
                TextColor3 = TEXT,
                TextSize = 12,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd
            }, row)

            create("TextLabel", {
                Position = UDim2.fromOffset(57, 29),
                Size = UDim2.new(1, -166, 0, 16),
                BackgroundTransparency = 1,
                Text = "@" .. player.Name,
                TextColor3 = MUTED,
                TextSize = 10,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd
            }, row)

            local pin = create("TextButton", {
                Position = UDim2.new(1, -99, 0.5, -16),
                Size = UDim2.fromOffset(31, 32),
                BackgroundColor3 = PANEL,
                BorderSizePixel = 0,
                Text = pinned[player.UserId] and "★" or "☆",
                TextColor3 = pinned[player.UserId] and ACCENT or MUTED,
                TextSize = 21,
                Font = Enum.Font.GothamBold,
                AutoButtonColor = false
            }, row)

            round(pin, 7)

            connect(pin.Activated, function()
                pinned[player.UserId] = not pinned[player.UserId]
                buildList()
            end)

            local tp = create("TextButton", {
                Position = UDim2.new(1, -62, 0.5, -14),
                Size = UDim2.fromOffset(55, 28),
                BackgroundColor3 = Color3.fromRGB(45, 45, 52),
                BorderSizePixel = 0,
                Text = "TP",
                TextColor3 = TEXT,
                TextSize = 11,
                Font = Enum.Font.GothamBold,
                AutoButtonColor = false
            }, row)

            round(tp, 7)

            connect(tp.Activated, function()
                if player.Parent == Players then
                    teleportTo(player)
                end
            end)

            connect(row.MouseEnter, function()
                animate(row, 0.1, {BackgroundColor3 = HOVER})
            end)

            connect(row.MouseLeave, function()
                animate(row, 0.1, {BackgroundColor3 = ROW})
            end)
        end
    end

    countLabel.Text = "PLAYERS: " .. #allPlayers .. "  |  SHOWING: " .. shown
    if shown == 0 then
        countLabel.Text = "NO PLAYERS FOUND"
    end
end

