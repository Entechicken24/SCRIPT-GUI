    s.Thickness = 1
    s.Parent = obj
end

local function makeLabel(parent, text, size, pos, textSize)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = text
    l.Size = size
    l.Position = pos
    l.TextColor3 = WHITE
    l.Font = Enum.Font.GothamMedium
    l.TextSize = textSize or 13
    l.TextWrapped = true
    l.Parent = parent
    return l
