-- GUI HELPERS
local function create(className, properties, parent)
    local obj = Instance.new(className)
    for key, value in pairs(properties) do
        obj[key] = value
    end
    obj.Parent = parent
    return obj
end

local function round(obj, radius)
    create("UICorner", {
        CornerRadius = UDim.new(0, radius or 10)
    }, obj)
end

local function border(obj, color, thickness)
    create("UIStroke", {
        Color = color or C.Gold,
        Thickness = thickness or 1,
        Transparency = 0.1
    }, obj)
end

local function text(parent, value, position, size, color, fontSize)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Text = value,
        TextColor3 = color or C.White,
        Font = Enum.Font.GothamMedium,
        TextSize = fontSize or 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Position = position,
        Size = size,
    }, parent)
end

local function makeButton(parent, value, position, size, bg, fg)
    local b = create("TextButton", {
        Text = value,
        Position = position,
        Size = size,
        BackgroundColor3 = bg or C.Surface,
        TextColor3 = fg or C.White,
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        BorderSizePixel = 0,
        AutoButtonColor = true,
    }, parent)
    round(b, 8)
    return b
end

local function makeDraggable(handle, target)
    local dragging = false
    local startPos
    local startInput

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startInput = input.Position
            startPos = target.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            local delta = input.Position - startInput
            target.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

local function getRoot(player)
    local character = player and player.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(player)
    local character = player and player.Character
    return character and character:FindFirstChildOfClass("Humanoid")
end

