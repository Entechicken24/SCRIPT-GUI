local function corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 9)
    c.Parent = obj
end

local function stroke(obj, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Theme.Cyan
    s.Thickness = thickness or 1
    s.Transparency = 0.15
    s.Parent = obj
end

local function new(className, props, parent)
    local obj = Instance.new(className)
    for key, value in pairs(props or {}) do
        obj[key] = value
    end
    obj.Parent = parent
    return obj
end

local function label(parent, text, pos, size, textSize, color, font)
    return new("TextLabel", {
        BackgroundTransparency = 1,
        Position = pos,
        Size = size,
        Text = text,
        TextSize = textSize or 12,
        TextColor3 = color or Theme.White,
        Font = font or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true,
        ZIndex = 5,
    }, parent)
end

local function button(parent, text, pos, size, accent)
    local b = new("TextButton", {
        Position = pos,
        Size = size,
        BackgroundColor3 = Theme.Surface,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = text,
        TextSize = 12,
        TextColor3 = Theme.White,
        TextWrapped = true,
        Font = Enum.Font.GothamBold,
        ZIndex = 10,
    }, parent)

    corner(b, 9)
    stroke(b, accent or Theme.Cyan, 1)

    b.MouseEnter:Connect(function()
        b.BackgroundColor3 = Theme.Hover
    end)

    b.MouseLeave:Connect(function()
        b.BackgroundColor3 = Theme.Surface
    end)

    return b
end

-- Drag a window by its title bar, or drag a floating button itself.
-- Supports both mouse and touch input.
local function makeDraggable(handle, object)
    local dragging = false
    local dragStart
    local startPosition
    local activeInput
    local moved = false
    local lastMove = 0

    handle.Active = true

    handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        dragging = true
        moved = false
        dragStart = input.Position
        startPosition = object.Position
        activeInput = input
        lastMove = 0

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                task.delay(0.12, function()
                    moved = false
                end)
            end
        end)
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end

        local validMouse = input.UserInputType
            == Enum.UserInputType.MouseMovement
        local validTouch = input == activeInput

        if not validMouse and not validTouch then
            return
        end

        local delta = input.Position - dragStart

        if math.abs(delta.X) > 3 or math.abs(delta.Y) > 3 then
            moved = true
        end

        if moved then
            lastMove = os.clock()

            object.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    -- Prevent a drag gesture from accidentally activating a button.
    if handle:IsA("TextButton") then
        handle.Activated:Connect(function()
            if moved or os.clock() - lastMove < 0.15 then
                return
            end
        end)
    end
end

