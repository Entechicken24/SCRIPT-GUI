-- Camera lock
local function stopCameraLock()
	cameraLocked = false

	if cameraConnection then
		cameraConnection:Disconnect()
		cameraConnection = nil
	end

	local camera = workspace.CurrentCamera
	if camera then
		if savedCameraType then
			camera.CameraType = savedCameraType
		end
		if savedCameraSubject and savedCameraSubject.Parent then
			camera.CameraSubject = savedCameraSubject
		end
	end

	savedCameraType = nil
	savedCameraSubject = nil
	camButton.Text = "CAM LOCK: OFF"
end

local function startCameraLock()
	local targetRoot = getRoot(selectedPlayer)
	if not targetRoot then
		status.Text = "SELECT A PLAYER WITH A CHARACTER"
		return
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	savedCameraType = camera.CameraType
	savedCameraSubject = camera.CameraSubject
	cameraLocked = true
	camera.CameraType = Enum.CameraType.Scriptable
	camButton.Text = "CAM LOCK: ON"

	cameraConnection = RunService.RenderStepped:Connect(function()
		if not cameraLocked then
			return
		end

		local myRoot = getRoot(player)
		local target = getRoot(selectedPlayer)
		if not myRoot or not target then
			return
		end

		camera = workspace.CurrentCamera
		if camera then
			local cameraPosition = myRoot.Position
				+ Vector3.new(0, 4, 9)
			local lookPosition = target.Position
				+ Vector3.new(0, 2, 0)
			camera.CFrame = CFrame.lookAt(cameraPosition, lookPosition)
		end
	end)
end

camButton.Activated:Connect(function()
	if not camCanActivate() then
		return
	end

	if cameraLocked then
		stopCameraLock()
	else
		startCameraLock()
	end
end)

-- Move toward selected player
local function stopMoving()
	moving = false
	moveToken += 1
	moveButton.Text = "START MOVE"
end

local function startMoving()
	if not selectedPlayer or not getRoot(selectedPlayer) then
		status.Text = "SELECT A PLAYER WITH A CHARACTER"
		return
	end

	local myHumanoid = getHumanoid(player)
	if not myHumanoid then
		status.Text = "YOUR CHARACTER IS NOT READY"
		return
	end

	moving = true
	moveToken += 1
	local thisToken = moveToken
	moveButton.Text = "STOP MOVE"

	task.spawn(function()
		while moving and moveToken == thisToken do
			local targetRoot = getRoot(selectedPlayer)
			myHumanoid = getHumanoid(player)

			if not targetRoot or not myHumanoid or myHumanoid.Health <= 0 then
				break
			end

			myHumanoid.WalkSpeed = moveSpeed
			myHumanoid:MoveTo(targetRoot.Position)

			task.wait(0.15)
		end

		if moveToken == thisToken then
			moving = false
			moveButton.Text = "START MOVE"
		end
	end)
end

moveButton.Activated:Connect(function()
	if not moveCanActivate() then
		return
	end

	if moving then
		stopMoving()
	else
		startMoving()
	end
end)

-- Keep floating controls within the screen on orientation changes
local function clampFloatingButtons()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	for _, button in ipairs({camButton, moveButton, reopenButton}) do
		local x, y = button.AbsolutePosition.X, button.AbsolutePosition.Y
		x = math.clamp(x, 0, math.max(0, camera.ViewportSize.X - button.AbsoluteSize.X))
		y = math.clamp(y, 0, math.max(0, camera.ViewportSize.Y - button.AbsoluteSize.Y))
		button.Position = UDim2.fromOffset(x, y)
	end
end

if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(
		clampFloatingButtons
	)
end

