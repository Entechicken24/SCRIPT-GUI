--// SMOOTH FOLLOW + CAMERA UPDATE
RunService:BindToRenderStep(
    "NeonCyberControlCenterUpdate",
    Enum.RenderPriority.Camera.Value + 1,
    function(deltaTime)
        if destroyed then
            return
        end

        applyNoclip()

        local targetRoot = getRoot(selectedPlayer)
        local targetHumanoid = getHumanoid(selectedPlayer)
        local localRoot = getRoot(LocalPlayer)
        local localCharacter = getCharacter(LocalPlayer)
        local localHumanoid = getHumanoid(LocalPlayer)

        if camLockEnabled and targetRoot then
            local camera = getCamera()

            if camera then
                camera.CFrame = CFrame.lookAt(
                    camera.CFrame.Position,
                    targetRoot.Position
                )
            end
        end

        if not followEnabled then
            return
        end

        if not targetRoot
            or not targetHumanoid
            or targetHumanoid.Health <= 0
            or not localRoot
            or not localHumanoid
            or localHumanoid.Health <= 0
            or not localCharacter
            or moveRoot ~= localRoot
            or not moveVelocity then

            setFollowEnabled(false)
            return
        end

        local destination = getSafeDestination(
            targetRoot,
            localCharacter,
            targetHumanoid
        )

        if not destination then
            currentVelocity = Vector3.zero
            moveVelocity.VectorVelocity = Vector3.zero

            statusText.Text = "WAITING FOR SAFE GROUND"
            statusText.TextColor3 = RED
            return
        end

        local difference = destination - localRoot.Position
        local distance = difference.Magnitude

        if distance <= CONFIG.FOLLOW_STOP_DISTANCE then
            currentVelocity = Vector3.zero
            moveVelocity.VectorVelocity = Vector3.zero

            statusText.Text =
                "FOLLOW: " .. tostring(CONFIG.FOLLOW_SPEED) .. " STUDS/SEC"
            statusText.TextColor3 = GREEN
            return
        end

        local airborne =
            targetHumanoid.FloorMaterial == Enum.Material.Air

        local desiredVelocity

        if airborne then
            local horizontalDifference = Vector3.new(
                difference.X,
                0,
                difference.Z
            )

            local horizontalDistance = horizontalDifference.Magnitude
            local horizontalSpeed = math.min(
                CONFIG.FOLLOW_SPEED,
                horizontalDistance * CONFIG.AIR_HORIZONTAL_RESPONSE
            )

            local horizontalVelocity = Vector3.zero

            if horizontalDistance > CONFIG.FOLLOW_STOP_DISTANCE then
                horizontalVelocity =
                    horizontalDifference.Unit * horizontalSpeed
            end

            local verticalSpeed = math.clamp(
                difference.Y * CONFIG.AIR_VERTICAL_RESPONSE,
                -math.min(CONFIG.FOLLOW_SPEED, CONFIG.AIR_MAX_VERTICAL_SPEED),
                math.min(CONFIG.FOLLOW_SPEED, CONFIG.AIR_MAX_VERTICAL_SPEED)
            )

            desiredVelocity = Vector3.new(
                horizontalVelocity.X,
                verticalSpeed,
                horizontalVelocity.Z
            )
        else
            local direction = difference.Unit
            local brakingSpeed = math.sqrt(
                2 * CONFIG.FOLLOW_BRAKING * distance
            )

            local targetSpeed = math.min(
                CONFIG.FOLLOW_SPEED,
                brakingSpeed
            )

            desiredVelocity = direction * targetSpeed
        end

        local response = airborne
            and CONFIG.AIR_HORIZONTAL_RESPONSE
            or CONFIG.FOLLOW_RESPONSE

        local alpha = 1 - math.exp(-response * math.max(deltaTime, 0))
        local smoothedVelocity = currentVelocity:Lerp(
            desiredVelocity,
            alpha
        )

        local maxChange =
            CONFIG.FOLLOW_ACCELERATION * math.max(deltaTime, 0)

        local velocityChange = smoothedVelocity - currentVelocity

        if velocityChange.Magnitude > maxChange then
            smoothedVelocity = currentVelocity
                + velocityChange.Unit * maxChange
        end

        currentVelocity = smoothedVelocity
        moveVelocity.VectorVelocity = currentVelocity

        statusText.Text =
            "FOLLOW: " .. tostring(CONFIG.FOLLOW_SPEED) .. " STUDS/SEC"
        statusText.TextColor3 = GREEN
    end
)

--// MINIMIZE / REOPEN
local function toggleMinimize()
    minimized = not minimized
    main.Visible = not minimized

    openGuiButton.Text = minimized and "OPEN GUI" or "CLOSE GUI"
end

minimizeButton.Activated:Connect(toggleMinimize)
closeButton.Activated:Connect(toggleMinimize)
openGuiButton.Activated:Connect(toggleMinimize)

table.insert(globalConnections, UserInputService.InputBegan:Connect(function(input, processed)
    if processed or destroyed then
        return
    end

    if input.KeyCode == Enum.KeyCode.N then
        toggleMinimize()
    end
end))

--// ANIMATED NEON BORDER
task.spawn(function()
    local hue = 0

    while gui.Parent and not destroyed do
        hue = (hue + 0.003) % 1
        local animatedColor = Color3.fromHSV(hue, 0.85, 1)

        if mainStroke and mainStroke.Parent then
            mainStroke.Color = animatedColor
        end

        if floating and floating.Parent then
            local outline = floating:FindFirstChildOfClass("UIStroke")

            if outline then
                outline.Color = animatedColor
            end
        end

        task.wait(0.03)
    end
end)

--// DESTROY GUI
destroyButton.Activated:Connect(function()
    destroyed = true
    followEnabled = false
    camLockEnabled = false
    noclipEnabled = false

    pcall(function()
        RunService:UnbindFromRenderStep(
            "NeonCyberControlCenterUpdate"
        )
    end)

    stopMovementConstraint()

    for part, originalValue in pairs(originalCollision) do
        if part and part.Parent then
            part.CanCollide = originalValue
        end
    end

    table.clear(originalCollision)

    for _, connection in ipairs(characterConnections) do
        connection:Disconnect()
    end

    for _, connection in ipairs(globalConnections) do
        connection:Disconnect()
    end

    clickSound:Destroy()
    gui:Destroy()
end)

