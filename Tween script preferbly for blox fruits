--========================================================
-- MOVEMENT CONTROLLER
-- LinearVelocity avoids repeatedly tweening the character CFrame.
-- This is a client-side prototype, not server-authoritative movement.
--========================================================

local function removeVelocity()
	if velocityConstraint then
		velocityConstraint:Destroy()
		velocityConstraint = nil
	end

	if rootAttachment then
		rootAttachment:Destroy()
		rootAttachment = nil
	end

	activeRoot = nil
end

local function stopMovement(message)
	movementActive = false
	removeVelocity()

	movementButton.Text = "START MOVE"
	statusLabel.Text = message or "MOVEMENT STOPPED"
end

local function setupVelocity(root)
	removeVelocity()
	activeRoot = root

	rootAttachment = create("Attachment", {
		Name = "NeonTravelAttachment"
	}, root)

	velocityConstraint = create("LinearVelocity", {
		Name = "NeonTravelVelocity",
		Attachment0 = rootAttachment,
		RelativeTo = Enum.ActuatorRelativeTo.World,
		VelocityConstraintMode = Enum.VelocityConstraintMode.Vector,
		VectorVelocity = Vector3.zero,
		ForceLimitsEnabled = false
	}, root)
end

local function startMovement()
	if not selectedPlayer or selectedPlayer == localPlayer then
		statusLabel.Text = "SELECT ANOTHER PLAYER"
		return
	end

	local _, myRoot = getCharacterParts(localPlayer)
	local _, targetRoot = getCharacterParts(selectedPlayer)

	if not myRoot or not targetRoot then
		statusLabel.Text = "CHARACTER NOT READY"
		return
	end

	movementActive = true
	movementButton.Text = "STOP MOVE"
	setupVelocity(myRoot)
	statusLabel.Text = "MOVING • " .. travelSpeed .. " SPS"
end

movementButton.Activated:Connect(function()
	if movementActive then
		stopMovement()
	else
		startMovement()
	end
end)

RunService.Heartbeat:Connect(function()
	if not movementActive then return end

	local _, myRoot = getCharacterParts(localPlayer)
	local _, targetRoot = getCharacterParts(selectedPlayer)

	if not myRoot or not targetRoot then
		stopMovement("CHARACTER OR TARGET UNAVAILABLE")
		return
	end

	if myRoot ~= activeRoot or not velocityConstraint then
		setupVelocity(myRoot)
	end

	local destination = targetRoot.Position
		- targetRoot.CFrame.LookVector * FOLLOW_DISTANCE

	local offset = destination - myRoot.Position
	local distance = offset.Magnitude

	if distance < 0.5 then
		velocityConstraint.VectorVelocity = Vector3.zero
	else
		local desiredSpeed = math.min(travelSpeed, distance * 4)
		velocityConstraint.VectorVelocity = offset.Unit * desiredSpeed
	end

	statusLabel.Text = "MOVING • " .. travelSpeed .. " SPS"
end)

--========================================================
-- CAMERA TRACK
-- Preserves Roblox's normal camera input. This gently shifts
-- the camera subject offset; it is not a hard camera lock.
--========================================================

local function stopCameraTracking()
	cameraTracking = false

	if cameraConnection then
		cameraConnection:Disconnect()
		cameraConnection = nil
	end

	if cameraHumanoid and cameraHumanoid.Parent and originalCameraOffset then
		cameraHumanoid.CameraOffset = originalCameraOffset
	end

	cameraHumanoid = nil
	originalCameraOffset = nil
	cameraOffset = Vector3.zero

	cameraButton.Text = "CAMERA TRACK: OFF"
end

local function startCameraTracking()
	if not selectedPlayer or selectedPlayer == localPlayer then
		statusLabel.Text = "SELECT A TARGET FOR CAMERA"
		return
	end

	local myHumanoid = getCharacterParts(localPlayer)

	if not myHumanoid then
		statusLabel.Text = "YOUR CHARACTER IS NOT READY"
		return
	end

	cameraTracking = true
	cameraHumanoid = myHumanoid
	originalCameraOffset = myHumanoid.CameraOffset
	cameraButton.Text = "CAMERA TRACK: ON"

	cameraConnection = RunService.RenderStepped:Connect(function(dt)
		if not cameraTracking then return end

		local _, targetRoot = getCharacterParts(selectedPlayer)
		local _, myRoot = getCharacterParts(localPlayer)

		if not targetRoot or not myRoot or not cameraHumanoid then
			return
		end

		local relative = myRoot.CFrame:VectorToObjectSpace(
			targetRoot.Position - myRoot.Position
		)

		local desiredOffset = Vector3.new(
			math.clamp(relative.X * 0.04, -1.5, 1.5),
			math.clamp(relative.Y * 0.02, -0.75, 0.75),
			0
		)

		local alpha = 1 - math.exp(-CAMERA_SMOOTHNESS * dt)
		cameraOffset = cameraOffset:Lerp(desiredOffset, alpha)
		cameraHumanoid.CameraOffset = originalCameraOffset + cameraOffset
	end)
end

cameraButton.Activated:Connect(function()
	if cameraTracking then
		stopCameraTracking()
		statusLabel.Text = "CAMERA TRACK OFF"
	else
		startCameraTracking()
	end
end)

