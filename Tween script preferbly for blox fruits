--========================================================
-- TOUCH AND MOUSE DRAGGING
--========================================================
-- Each button tracks its own starting input.
-- TouchMoved/TouchEnded match the finger by TouchId.
-- Mouse movement/release is handled separately.
-- A drag never triggers the button action.

local function makeDraggable(button, onTap)
	local active = false
	local inputType = nil
	local activeTouchId = nil
	local startPoint = nil
	local startPosition = nil
	local didMove = false
	local threshold = 8

	local function getPoint(input)
		return Vector2.new(input.Position.X, input.Position.Y)
	end

	local function moveTo(point)
		if not active or not startPoint or not startPosition then
			return
		end

		local delta = point - startPoint

		if delta.Magnitude >= threshold then
			didMove = true
		end

		if not didMove then
			return
		end

		local camera = workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize

		local x = startPosition.X + delta.X
		local y = startPosition.Y + delta.Y

		if viewport then
			x = math.clamp(
				x, 0,
				math.max(0, viewport.X - button.AbsoluteSize.X)
			)
			y = math.clamp(
				y, 0,
				math.max(0, viewport.Y - button.AbsoluteSize.Y)
			)
		end

		button.Position = UDim2.fromOffset(x, y)
	end

	local function finish()
		if not active then
			return
		end

		local wasDragged = didMove

		active = false
		inputType = nil
		activeTouchId = nil
		startPoint = nil
		startPosition = nil
		didMove = false

		if not wasDragged and not destroyed and onTap then
			onTap()
		end
	end

	connect(button.InputBegan, function(input)
		if destroyed or active then
			return
		end

		if input.UserInputType == Enum.UserInputType.Touch then
			active = true
			inputType = "Touch"
			activeTouchId = input.TouchId

		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			active = true
			inputType = "Mouse"

		else
			return
		end

		startPoint = getPoint(input)
		startPosition = button.AbsolutePosition
		didMove = false
	end)

	-- Touch movement on iPad.
	connect(UIS.TouchMoved, function(input)
		if not active or inputType ~= "Touch" then
			return
		end

		if input.TouchId == activeTouchId then
			moveTo(getPoint(input))
		end
	end)

	-- Finish only when the same finger is lifted.
	connect(UIS.TouchEnded, function(input)
		if not active or inputType ~= "Touch" then
			return
		end

		if input.TouchId == activeTouchId then
			moveTo(getPoint(input))
			finish()
		end
	end)

	-- Mouse movement on computers.
	connect(UIS.InputChanged, function(input)
		if not active or inputType ~= "Mouse" then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement then
			moveTo(getPoint(input))
		end
	end)

	connect(UIS.InputEnded, function(input)
		if not active or inputType ~= "Mouse" then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			finish()
		end
	end)
end

--========================================================
-- CHARACTER AND SPEED
--========================================================

local function getCharacter()
	return player.Character
end

local function getHumanoid()
	local character = getCharacter()
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function getRoot(target)
	local character = target and target.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function applySpeed()
	local humanoid = getHumanoid()

	if humanoid then
		if savedWalkSpeed == nil then
			savedWalkSpeed = humanoid.WalkSpeed
		end
		humanoid.WalkSpeed = walkSpeed
	end

	speedLabel.Text = "WALK SPEED: " .. walkSpeed
end

connect(player.CharacterAdded, function()
	savedWalkSpeed = nil
	task.wait(0.3)

	if destroyed then
		return
	end

	applySpeed()
end)

--========================================================
-- PLAYER LIST AND AVATARS
--========================================================

local function updateTargetLabel()
	if selectedPlayer and selectedPlayer.Parent == Players then
		targetLabel.Text = "TARGET: " .. selectedPlayer.DisplayName
	else
		selectedPlayer = nil
		targetLabel.Text = "TARGET: NONE"
	end
end

local function refreshPlayerList()
	if destroyed then
		return
	end

	for _, child in ipairs(playerList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local list = Players:GetPlayers()

	table.sort(list, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)

	for _, target in ipairs(list) do
		if target ~= player then
			local row = create("TextButton", {
				Name = target.Name,
				Size = UDim2.new(1, -4, 0, 42),
				BackgroundColor3 = target == selectedPlayer
					and Color3.fromRGB(75, 55, 20)
					or DARK,
				Text = "",
				BorderSizePixel = 0,
				AutoButtonColor = true,
			}, playerList)

			create("UICorner", {
				CornerRadius = UDim.new(0, 6),
			}, row)

			local avatar = create("ImageLabel", {
				Size = UDim2.fromOffset(32, 32),
				Position = UDim2.fromOffset(5, 5),
				BackgroundColor3 = PANEL,
				BorderSizePixel = 0,
				Image = "",
			}, row)

			create("UICorner", {
				CornerRadius = UDim.new(1, 0),
			}, avatar)

			task.spawn(function()
				local ok, image = pcall(function()
					return Players:GetUserThumbnailAsync(
						target.UserId,
						Enum.ThumbnailType.HeadShot,
						Enum.ThumbnailSize.Size100x100
					)
				end)

				if ok and avatar.Parent then
					avatar.Image = image
				end
			end)

			create("TextLabel", {
				Size = UDim2.new(1, -47, 1, 0),
				Position = UDim2.fromOffset(43, 0),
				BackgroundTransparency = 1,
				Text = target.DisplayName .. "  @" .. target.Name,
				TextColor3 = WHITE,
				TextSize = 11,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			}, row)

			connect(row.Activated, function()
				if destroyed or target.Parent ~= Players then
					return
				end

				selectedPlayer = target
				updateTargetLabel()
				refreshPlayerList()
			end)
		end
	end
end

connect(Players.PlayerAdded, function()
	task.delay(0.5, refreshPlayerList)
end)

connect(Players.PlayerRemoving, function(target)
	if selectedPlayer == target then
		selectedPlayer = nil
		updateTargetLabel()
	end

	task.delay(0.2, refreshPlayerList)
end)

--========================================================
-- CAMERA LOCK
--========================================================

local function setCameraLock(enabled)
	cameraLock = enabled

	cameraPanelButton.Text = "CAM LOCK: " .. (enabled and "ON" or "OFF")
	cameraFloat.Text = "CAM LOCK: " .. (enabled and "ON" or "OFF")

	if cameraConnection then
		cameraConnection:Disconnect()
		cameraConnection = nil
	end

	if enabled then
		cameraConnection = RunService:BindToRenderStep(
			"NeonCyberCameraLock",
			Enum.RenderPriority.Camera.Value + 1,
			function()
				if destroyed or not cameraLock then
					return
				end

				local targetCharacter = selectedPlayer
					and selectedPlayer.Character

				local targetPart = targetCharacter and (
					targetCharacter:FindFirstChild("Head")
					or targetCharacter:FindFirstChild("HumanoidRootPart")
				)

				local camera = workspace.CurrentCamera

				if camera and targetPart then
					camera.CFrame = CFrame.lookAt(
						camera.CFrame.Position,
						targetPart.Position
					)
				end
			end
		)
	end

	statusLabel.Text = enabled
		and "STATUS: CAMERA LOCK ON"
		or "STATUS: READY"
end

--========================================================
-- SMOOTH 3D FOLLOW
--========================================================

local function setFollowing(enabled)
	following = enabled

	followPanelButton.Text = "START MOVE: " .. (enabled and "ON" or "OFF")
	moveFloat.Text = "START MOVE: " .. (enabled and "ON" or "OFF")

	if followConnection then
		followConnection:Disconnect()
		followConnection = nil
	end

	if enabled then
		followConnection = RunService.Heartbeat:Connect(function(dt)
			if destroyed or not following then
				return
			end

			local targetRoot = getRoot(selectedPlayer)
			local myRoot = getRoot(player)

			if not targetRoot or not myRoot then
				return
			end

			local goal = targetRoot.CFrame * CFrame.new(0, 3, 5)
			local alpha = 1 - math.exp(-5 * math.clamp(dt, 0, 0.1))

			myRoot.CFrame = myRoot.CFrame:Lerp(goal, alpha)
			myRoot.AssemblyLinearVelocity = targetRoot.AssemblyLinearVelocity
		end)
	end

	statusLabel.Text = enabled
		and "STATUS: FOLLOWING TARGET"
		or "STATUS: READY"
end

--========================================================
-- LOOP NOCLIP
-- Client-side collision testing in your own experience.
--========================================================

local function restoreCollisions()
	for part, originalValue in pairs(originalCollisions) do
		if part and part.Parent then
			part.CanCollide = originalValue
		end
	end

	table.clear(originalCollisions)
end

local function setNoclip(enabled)
	noclip = enabled
	noclipButton.Text = "LOOP NOCLIP: " .. (enabled and "ON" or "OFF")

	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end

	if enabled then
		noclipConnection = RunService.Stepped:Connect(function()
			if destroyed or not noclip then
				return
			end

			local character = getCharacter()
			if not character then
				return
			end

			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					if originalCollisions[part] == nil then
						originalCollisions[part] = part.CanCollide
					end

					part.CanCollide = false
				end
			end
		end)

		statusLabel.Text = "STATUS: NOCLIP ON"
	else
		restoreCollisions()
		statusLabel.Text = "STATUS: READY"
	end
end

