--==================================================
-- PLAYER LEAVING / RESPAWN
--==================================================

Players.PlayerAdded:Connect(refreshPlayers)

Players.PlayerRemoving:Connect(function(player)
    if player == targetPlayer then
        if followOn then
            stopFollow("Target left the server.")
        end

        if aimOn then
            stopAim("Target left the server.")
        end

        if loopTweenOn then
            stopLoopTween("Target left the server.")
        end

        targetPlayer = nil
        refreshSelectedLabel()
    end

    refreshPlayers()
end)

Me.CharacterAdded:Connect(function()
    task.wait(0.5)

    if loopTweenOn then
        stopLoopTween("Tween stopped after respawn.")
    end

    if aimOn then
        local camera = workspace.CurrentCamera
        local _, humanoid = localParts()

        if camera then
            camera.CameraType = Enum.CameraType.Scriptable
            if humanoid then
                savedCameraSubject = humanoid
            end
        end
    end
end)

