-- Reliable touch and mouse dragging, including the N button.
local dragClickSuppression = setmetatable({}, {__mode = "k"})

local function makeDraggable(b)
	local dragging = false
	local activeInput
	local touchId
	local startPointer
	local startPosition
	local moved = false

	local function clamp(x, y)
		local camera = workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
		return math.clamp(x, 0, math.max(0, viewport.X - b.AbsoluteSize.X)),
			math.clamp(y, 0, math.max(0, viewport.Y - b.AbsoluteSize.Y))
	end

	b.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch
			and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end

		dragging = true
		activeInput = input
		touchId = input.UserInputType == Enum.UserInputType.Touch
			and input.TouchId or nil
		startPointer = input.Position
		startPosition = b.AbsolutePosition
		moved = false
	end)

	UIS.InputChanged:Connect(function(input)
		if not dragging then return end

		local mouseMove = input.UserInputType == Enum.UserInputType.MouseMovement
			and activeInput
			and activeInput.UserInputType == Enum.UserInputType.MouseButton1

		local touchMove = input.UserInputType == Enum.UserInputType.Touch
			and touchId ~= nil
			and input.TouchId == touchId

		if not mouseMove and not touchMove then return end

		local delta = input.Position - startPointer
		if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
			moved = true
		end

		local x, y = clamp(
			startPosition.X + delta.X,
			startPosition.Y + delta.Y
		)
		b.Position = UDim2.fromOffset(x, y)
	end)

	UIS.InputEnded:Connect(function(input)
		local mouseEnd = input.UserInputType == Enum.UserInputType.MouseButton1
			and activeInput
			and activeInput.UserInputType == Enum.UserInputType.MouseButton1

		local touchEnd = input.UserInputType == Enum.UserInputType.Touch
			and touchId ~= nil
			and input.TouchId == touchId

		if dragging and (mouseEnd or touchEnd) then
			dragging = false
			activeInput = nil
			touchId = nil

			if moved then
				dragClickSuppression[b] = true
				task.delay(0.3, function()
					dragClickSuppression[b] = nil
				end)
			end
		end
	end)
end

local function canClick(b)
	if dragClickSuppression[b] then
		dragClickSuppression[b] = nil
		return false
	end
	return true
end

