local function stopLoop()
    loopEnabled = false
    loopToken += 1

    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end

    loopButton.Text = "START LOOP TWEEN"
    loopButton.BackgroundColor3 = Theme.Purple
    status.Text = "STATUS: STOPPED"
    status.TextColor3 = Theme.Muted
end

local function startLoop()
    if not selectedPlayer or selectedPlayer == Me then
        status.Text = "STATUS: SELECT A PLAYER"
        status.TextColor3 = Theme.Red
        return
    end

    if not getRoot(Me) or not getRoot(selectedPlayer) then
        status.Text = "STATUS: CHARACTER NOT READY"
        status.TextColor3 = Theme.Red
        return
    end

    loopEnabled = true
    loopToken += 1
    local myToken = loopToken

    loopButton.Text = "STOP LOOP TWEEN"
    loopButton.BackgroundColor3 = Theme.Red
    status.Text = "STATUS: LOOP ACTIVE"
    status.TextColor3 = Theme.Green

    task.spawn(function()
        while loopEnabled and loopToken == myToken do
            local myRoot = getRoot(Me)
            local targetRoot = getRoot(selectedPlayer)
            local myHumanoid = getHumanoid(Me)

            if not myRoot or not targetRoot or not myHumanoid then
                status.Text = "STATUS: CHARACTER NOT READY"
                break
            end

            -- Tween to a nearby position, not inside the target.
            local offset = targetRoot.CFrame.LookVector * FOLLOW_DISTANCE
            local destination = CFrame.new(
                targetRoot.Position + offset,
                targetRoot.Position
            )

            local duration = tweenDuration
            activeTween = TweenService:Create(
                myRoot,
                TweenInfo.new(
                    duration,
                    Enum.EasingStyle.Linear,
                    Enum.EasingDirection.Out
                ),
                {CFrame = destination}
            )

            activeTween:Play()
            activeTween.Completed:Wait()
            activeTween = nil

            task.wait(0.1)
        end

        if loopToken == myToken then
            stopLoop()
        end
    end)
end

loopButton.Activated:Connect(function()
    if loopEnabled then
        stopLoop()
    else
        startLoop()
    end
end)

-- AIM LOCK: CAMERA TRACKING OF SELECTED PLAYER
local aimButton = button(gui, "AIM LOCK: OFF",
    UDim2.new(0, 20, 0, 150),
    UDim2.new(0, 150, 0, 36), Theme.Panel)
