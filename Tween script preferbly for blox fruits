			child:Destroy()
		end
	end

	local list = Players:GetPlayers()

	table.sort(list, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)

	for _, player in ipairs(list) do
		local isSelected = player == selectedPlayer

		local card = create("TextButton", {
			Name = "Player_" .. player.UserId,
			Size = UDim2.new(1, -4, 0, 54),
			BackgroundColor3 = isSelected
				and Color3.fromRGB(62, 48, 25)
				or Color3.fromRGB(24, 24, 27),
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = true,
			LayoutOrder = 0
		}, playerList)

		addCorner(card, 8)
		addStroke(card, GOLD, isSelected and 1.5 or 1, isSelected and 0.1 or 0.7)

		local avatar = create("ImageLabel", {
			Name = "Avatar",
			Position = UDim2.fromOffset(5, 5),
			Size = UDim2.fromOffset(42, 42),
			BackgroundColor3 = INNER,
			BorderSizePixel = 0,
			Image = "",
			ScaleType = Enum.ScaleType.Fit
		}, card)

		addCorner(avatar, 7)
		addStroke(avatar, GOLD, 1, 0.35)

		-- Fetch the actual Roblox headshot thumbnail.
		task.spawn(function()
			local ok, image = pcall(function()
				return Players:GetUserThumbnailAsync(
					player.UserId,
					Enum.ThumbnailType.HeadShot,
					Enum.ThumbnailSize.Size100x100
				)
			end)

			if ok and avatar.Parent then
				avatar.Image = image
			end
		end)

		create("TextLabel", {
			Position = UDim2.fromOffset(56, 7),
			Size = UDim2.new(1, -64, 0, 22),
			BackgroundTransparency = 1,
			Text = player.DisplayName,
			TextColor3 = isSelected and LIGHT_GOLD or WHITE,
			TextSize = 13,
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd
		}, card)

		create("TextLabel", {
			Position = UDim2.fromOffset(56, 29),
			Size = UDim2.new(1, -64, 0, 16),
			BackgroundTransparency = 1,
			Text = "@" .. player.Name,
			TextColor3 = MUTED,
			TextSize = 10,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd
		}, card)

		card.Activated:Connect(function()
			selectedPlayer = player
			targetLabel.Text = "TARGET: " .. player.DisplayName
			refreshPlayers()
		end)
	end

	if selectedPlayer and selectedPlayer.Parent == Players then
		targetLabel.Text = "TARGET: " .. selectedPlayer.DisplayName
	else
		targetLabel.Text = "TARGET: NONE"
	end
end

