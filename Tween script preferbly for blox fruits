-- Mouse wheel zoom while camera lock is active.
UIS.InputChanged:Connect(function(input, gameProcessed)
    if not cameraLocked or gameProcessed then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseWheel then
        if input.Position.Z > 0 then
            changeZoom(-ZOOM_STEP)
        elseif input.Position.Z < 0 then
            changeZoom(ZOOM_STEP)
        end
    end
end)

speedBox.FocusLost:Connect(function()
    speed = math.clamp(
        tonumber(speedBox.Text) or SPEED_MAX,
        5,
        SPEED_MAX
    )

    speedBox.Text = tostring(speed)
end)

Players.PlayerAdded:Connect(function()
    task.defer(refreshPlayers)
end)

Players.PlayerRemoving:Connect(function(player)
    if player == selected then
        cleanup()
        selected = nil
        updateQuick()
        updateSelectionStatus()
    end

    task.defer(refreshPlayers)
end)

-- KEEP FOLLOW + CAMERA ACTIVE THROUGH RESPAWNS
me.CharacterAdded:Connect(function(character)
    if not running then
        return
    end

    task.spawn(function()
        local root = character:WaitForChild("HumanoidRootPart", 10)
        local humanoid = character:WaitForChild("Humanoid", 10)

        if not running or me.Character ~= character
            or not root or not humanoid then
            return
        end

        attachMovement(character)

        -- Camera lock remains enabled; the render loop picks up
        -- the new character and camera automatically.
        updateQuick()
        updateCameraLabel()
    end)
end)

-- INITIALIZE
updateZoomLabel()
refreshPlayers()
updateQuick()
updateSelectionStatus()
updateCameraLabel()
