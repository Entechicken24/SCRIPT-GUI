local function corner(object, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 10)
    c.Parent = object
    return c
end

local function stroke(object, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or GOLD
    s.Thickness = thickness or 1
    s.Parent = object
    return s
end

local function label(parent, text, size, position, textSize)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Size = size
    l.Position = position
    l.Text = text
    l.TextColor3 = WHITE
    l.Font = Enum.Font.GothamMedium
    l.TextSize = textSize or 13
    l.TextWrapped = true
    l.Parent = parent
    return l
end

local function button(parent, text, size, position)
    local b = Instance.new("TextButton")
    b.Size = size
    b.Position = position
    b.BackgroundColor3 = PANEL
    b.Text = text
    b.TextColor3 = GOLD
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.AutoButtonColor = true
    b.ZIndex = 20
    b.Parent = parent
    corner(b, 9)
    stroke(b, GOLD, 1)
    return b
end

local function section(parent, text, height)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, -4, 0, height)
    f.BackgroundColor3 = PANEL
    f.BorderSizePixel = 0
    f.Parent = parent
    corner(f, 10)
    stroke(f, Color3.fromRGB(93, 74, 42), 1)

    local t = label(
        f,
        text,
        UDim2.new(1, -16, 0, 25),
        UDim2.fromOffset(8, 4),
        13
    )
    t.TextColor3 = GOLD
    t.TextXAlignment = Enum.TextXAlignment.Left

    return f
end

