--==================================================
-- DRAGGABLE PANEL
--==================================================

local dragging = false
local dragStart = nil
local startPosition = nil

header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPosition = main.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

--==================================================
-- SPEED INPUT
--==================================================

local function setSpeed(value)
	value = tonumber(value)

	if not value then
		value = travelSpeed
	end

	travelSpeed = math.clamp(
		math.floor(value + 0.5),
		MIN_SPEED,
		MAX_SPEED
	)

	speedBox.Text = tostring(travelSpeed)
end

speedBox.FocusLost:Connect(function()
	setSpeed(speedBox.Text)
end)

minusButton.Activated:Connect(function()
	setSpeed(travelSpeed - SPEED_STEP)
end)

plusButton.Activated:Connect(function()
	setSpeed(travelSpeed + SPEED_STEP)
end)

resetButton.Activated:Connect(function()
	setSpeed(DEFAULT_SPEED)
end)

--==================================================
-- PLAYER SELECTOR
--==================================================

local function updateSelectedLabel()
	if selectedPlayer and selectedPlayer.Parent == Players then
		selectedLabel.Text = "TARGET: " .. selectedPlayer.DisplayName
	else
		selectedLabel.Text = "TARGET: NONE"
	end
end

local function refreshPlayers()
	for _, child in ipairs(playerList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local allPlayers = Players:GetPlayers()

	table.sort(allPlayers, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)

	for _, player in ipairs(allPlayers) do
		local entry = create("TextButton", {
			Name = player.Name,
			Size = UDim2.new(1, -4, 0, 30),
			BackgroundColor3 = player == selectedPlayer
				and Color3.fromRGB(64, 49, 25) or PANEL,
			BorderSizePixel = 0,
			Text = "  " .. player.DisplayName .. "  (@" .. player.Name .. ")",
			TextColor3 = player == selectedPlayer and PALE_GOLD or WHITE,
			TextSize = 11,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
			AutoButtonColor = true
		}, playerList)

		addCorner(entry, 6)

		entry.Activated:Connect(function()
			selectedPlayer = player
			updateSelectedLabel()
			refreshPlayers()
		end)
	end

	updateSelectedLabel()
end

Players.PlayerAdded:Connect(refreshPlayers)

Players.PlayerRemoving:Connect(function(player)
	if selectedPlayer == player then
		selectedPlayer = nil
	end
	refreshPlayers()
end)

refreshPlayers()

--==================================================
-- MOVEMENT CONTROLLER
-- Uses LinearVelocity rather than tweening HumanoidRootPart.CFrame.
-- This supports movement toward targets in 3D, including while airborne.
--==================================================

local function removeMover()
	if linearVelocity then
		linearVelocity:Destroy()
		linearVelocity = nil
	end

	if moverAttachment then
		moverAttachment:Destroy()
		moverAttachment = nil
	end

	moverRoot = nil
end

local function stopMovement(message)
	movementActive = false
	removeMover()

	movementButton.Text = "START MOVE"
	movementButton.BackgroundColor3 = Color3.fromRGB(39, 32, 19)

	if message then
		statusLabel.Text = message
	else
		statusLabel.Text = "MOVEMENT STOPPED"
	end
end

local function setupMover(root)
	removeMover()

	moverRoot = root

	moverAttachment = create("Attachment", {
		Name = "NeonTravelAttachment"
	}, root)

	linearVelocity = create("LinearVelocity", {
		Name = "NeonTravelVelocity",
		Attachment0 = moverAttachment,
		RelativeTo = Enum.ActuatorRelativeTo.World,
		VelocityConstraintMode = Enum.VelocityConstraintMode.Vector,
		VectorVelocity = Vector3.zero,
		ForceLimitsEnabled = false
	}, root)
end

local function startMovement()
	if not selectedPlayer or selectedPlayer == localPlayer then
		statusLabel.Text = "SELECT ANOTHER PLAYER FIRST"
		return
	end

	local _, targetRoot = getCharacterParts(selectedPlayer)
	local _, localRoot = getCharacterParts(localPlayer)

	if not targetRoot or not localRoot then
		statusLabel.Text = "TARGET OR CHARACTER NOT READY"
		return
	end

	movementActive = true
	movementButton.Text = "STOP MOVE"
	movementButton.BackgroundColor3 = Color3.fromRGB(72, 48, 20)
	statusLabel.Text = "MOVING  •  " .. travelSpeed .. " SPS"

	setupMover(localRoot)
end

movementButton.Activated:Connect(function()
	if movementActive then
		stopMovement("MOVEMENT STOPPED")
	else
		startMovement()
	end
end)

RunService.Heartbeat:Connect(function()
	if not movementActive then
		return
	end

	local _, localRoot = getCharacterParts(localPlayer)
	local _, targetRoot = getCharacterParts(selectedPlayer)

	if not localRoot or not targetRoot then
		stopMovement("TARGET OR CHARACTER UNAVAILABLE")
		return
	end

	if moverRoot ~= localRoot or not linearVelocity or not linearVelocity.Parent then
		setupMover(localRoot)
	end

	-- Follow a point just behind the selected player's character.
	local destination = targetRoot.Position - targetRoot.CFrame.LookVector * STOP_DISTANCE
	local offset = destination - localRoot.Position
	local distance = offset.Magnitude

	if distance < 0.5 then
		linearVelocity.VectorVelocity = Vector3.zero
	else
		-- Smoothly slow down near the destination to reduce overshooting.
		local desiredSpeed = math.min(travelSpeed, distance * 4)
		linearVelocity.VectorVelocity = offset.Unit * desiredSpeed
	end

	statusLabel.Text = "MOVING  •  " .. travelSpeed .. " SPS"
end)

--==================================================
-- CAMERA TRACK
-- Keeps Roblox's normal camera active.
-- Position remains controlled by the default camera; only its aim is blended.
--==================================================

local function stopCameraTracking()
	if cameraBound then
		RunService:UnbindFromRenderStep(cameraConnectionName)
		cameraBound = false
	end

	cameraTracking = false
	cameraButton.Text = "CAMERA: OFF"
	cameraButton.BackgroundColor3 = INNER
end

local function startCameraTracking()
	if not selectedPlayer or selectedPlayer == localPlayer then
		statusLabel.Text = "SELECT A TARGET FOR CAMERA TRACK"
		return
	end

	cameraTracking = true
	cameraButton.Text = "CAMERA: ON"
	cameraButton.BackgroundColor3 = Color3.fromRGB(72, 48, 20)

	RunService:BindToRenderStep(
		cameraConnectionName,
		Enum.RenderPriority.Camera.Value + 1,
		function(deltaTime)
			if not cameraTracking then
				return
			end

			local _, targetRoot = getCharacterParts(selectedPlayer)
			local camera = workspace.CurrentCamera

			if not targetRoot or not camera then
				return
			end

			local currentPosition = camera.CFrame.Position
			local targetPosition = targetRoot.Position

			local difference = targetPosition - currentPosition
			if difference.Magnitude < 0.01 then
				return
			end

			local desiredCFrame = CFrame.lookAt(
				currentPosition,
				targetPosition
			)

			local alpha = 1 - math.exp(-CAMERA_SMOOTHNESS * deltaTime)

			-- Keep the current camera position, smoothly adjust its direction.
			camera.CFrame = camera.CFrame:Lerp(desiredCFrame, alpha)
		end
	)

	cameraBound = true
end

cameraButton.Activated:Connect(function()
	if cameraTracking then
		stopCameraTracking()
	else
		startCameraTracking()
	end
end)

