--// SPEED SETTING
local function applySpeed()
    local value = tonumber(speedInput.Text)

    if not value or value ~= value
        or value == math.huge or value == -math.huge then

        speedInput.Text = tostring(CONFIG.FOLLOW_SPEED)
        statusText.Text = "INVALID SPEED VALUE"
        statusText.TextColor3 = RED
        return
    end

    CONFIG.FOLLOW_SPEED = math.clamp(
        value,
        CONFIG.MIN_FOLLOW_SPEED,
        CONFIG.MAX_FOLLOW_SPEED
    )

    speedInput.Text = tostring(CONFIG.FOLLOW_SPEED)
    statusText.Text = "SPEED SET: "
        .. tostring(CONFIG.FOLLOW_SPEED) .. " STUDS/SEC"
    statusText.TextColor3 = GREEN
end

applySpeedButton.Activated:Connect(applySpeed)

speedInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        applySpeed()
    end
end)

