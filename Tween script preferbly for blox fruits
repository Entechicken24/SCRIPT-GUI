--// REAL DRAG HANDLER
--// No Activated event is used for the floating buttons.
--// A click is processed only when the pointer did not drag.

local function makeDraggable(button, onClick)
	local active = false
	local activeKind = nil
	local touchId = nil
	local startPointer = nil
	local startPosition = nil
	local didMove = false
	local activeInput = nil
	local dragThreshold = 8

	local function pointerPosition(input)
		return Vector2.new(input.Position.X, input.Position.Y)
	end

	local function clampPosition(x, y)
		local camera = workspace.CurrentCamera
		if not camera then
			return x, y
		end

		local viewport = camera.ViewportSize
		local size = button.AbsoluteSize

		x = math.clamp(x, 0, math.max(0, viewport.X - size.X))
		y = math.clamp(y, 0, math.max(0, viewport.Y - size.Y))

		return x, y
	end

	local function updateDrag(pointer)
		if not active or not startPointer or not startPosition then
			return
		end

		local delta = pointer - startPointer

		if delta.Magnitude >= dragThreshold then
			didMove = true
		end

		if didMove then
			local x, y = clampPosition(
				startPosition.X + delta.X,
				startPosition.Y + delta.Y
			)
			button.Position = UDim2.fromOffset(x, y)
		end
	end

	track(button.InputBegan:Connect(function(input)
		if destroyed or active then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			active = true
			activeKind = "Mouse"
		elseif input.UserInputType == Enum.UserInputType.Touch then
			active = true
			activeKind = "Touch"
			touchId = input.TouchId
		else
			return
		end

		activeInput = input
		startPointer = pointerPosition(input)
		startPosition = button.AbsolutePosition
		didMove = false
	end))

	track(UIS.InputChanged:Connect(function(input)
		if not active or destroyed then
			return
		end

		if activeKind == "Mouse"
			and input.UserInputType == Enum.UserInputType.MouseMovement then
			updateDrag(pointerPosition(input))
		elseif activeKind == "Touch"
			and input.UserInputType == Enum.UserInputType.Touch
			and input.TouchId == touchId then
			activeInput = input
			updateDrag(pointerPosition(input))
		end
	end))

	-- Poll the active touch as an additional mobile fallback.
	track(RunService.RenderStepped:Connect(function()
		if not active or destroyed or not activeInput then
			return
		end

		if activeKind == "Touch" then
			updateDrag(pointerPosition(activeInput))
		end
	end))

	track(UIS.InputEnded:Connect(function(input)
		if not active or destroyed then
			return
		end

		local matching = false

		if activeKind == "Mouse"
			and input.UserInputType == Enum.UserInputType.MouseButton1 then
			matching = true
		elseif activeKind == "Touch"
			and input.UserInputType == Enum.UserInputType.Touch
			and input.TouchId == touchId then
			matching = true
		end

		if not matching then
			return
		end

		-- Use the release position before deciding whether this was a click.
		updateDrag(pointerPosition(input))

		local wasDragged = didMove

		active = false
		activeKind = nil
		touchId = nil
		activeInput = nil
		startPointer = nil
		startPosition = nil
		didMove = false

		if not wasDragged and onClick then
			onClick()
		end
	end))
end

--// CHARACTER HELPERS

local function getCharacter()
	return LocalPlayer.Character
end

local function getHumanoid()
	local character = getCharacter()
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function getRoot(player)
	local character = player and player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function applySpeed()
	local humanoid = getHumanoid()
	if humanoid then
		humanoid.WalkSpeed = walkSpeed
	end
	speedLabel.Text = "WALK SPEED: " .. walkSpeed
end

track(LocalPlayer.CharacterAdded:Connect(function()
	task.wait(0.3)
	if destroyed then
		return
	end
	applySpeed()
	table.clear(originalCollisions)
end))

--// PLAYER SELECTION

local function updateSelectedLabel()
	if selectedPlayer and selectedPlayer.Parent == Players then
		selectedLabel.Text = "TARGET: " .. selectedPlayer.DisplayName
	else
		selectedPlayer = nil
		selectedLabel.Text = "TARGET: NONE"
	end
end

local function refreshPlayerList()
	if destroyed then
		return
	end

	for _, child in ipairs(playerList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local playerArray = Players:GetPlayers()
	table.sort(playerArray, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)

	for _, player in ipairs(playerArray) do
		if player ~= LocalPlayer and not destroyed then
			local row = make("TextButton", {
				Name = player.Name,
				Size = UDim2.new(1, -4, 0, 42),
				BackgroundColor3 = player == selectedPlayer
					and Color3.fromRGB(75, 55, 20) or DARK,
				Text = "",
				BorderSizePixel = 0,
				AutoButtonColor = false,
			}, playerList)

			make("UICorner", {CornerRadius = UDim.new(0, 6)}, row)

			local avatar = make("ImageLabel", {
				Size = UDim2.fromOffset(32, 32),
				Position = UDim2.fromOffset(5, 5),
				BackgroundColor3 = PANEL,
				BorderSizePixel = 0,
				Image = "",
			}, row)
			make("UICorner", {CornerRadius = UDim.new(1, 0)}, avatar)

			task.spawn(function()
				local success, image = pcall(function()
					return Players:GetUserThumbnailAsync(
						player.UserId,
						Enum.ThumbnailType.HeadShot,
						Enum.ThumbnailSize.Size100x100
					)
				end)

				if success and avatar.Parent then
					avatar.Image = image
				end
			end)

			make("TextLabel", {
				Size = UDim2.new(1, -48, 1, 0),
				Position = UDim2.fromOffset(44, 0),
				BackgroundTransparency = 1,
				Text = player.DisplayName .. "  (@" .. player.Name .. ")",
				TextColor3 = WHITE,
				Font = Enum.Font.GothamMedium,
				TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			}, row)

			track(row.Activated:Connect(function()
				if destroyed or player.Parent ~= Players then
					return
				end

				selectedPlayer = player
				updateSelectedLabel()
				refreshPlayerList()
			end))
		end
	end
end

track(Players.PlayerAdded:Connect(function()
	task.delay(0.5, refreshPlayerList)
end))

track(Players.PlayerRemoving:Connect(function(player)
	if selectedPlayer == player then
		selectedPlayer = nil
		updateSelectedLabel()
	end
	task.delay(0.1, refreshPlayerList)
end))

--// CAM LOCK
-- Keeps the normal Roblox camera and aims it at the selected player.

local function setCameraLock(enabled)
	cameraLock = enabled
	cameraPanelButton.Text = "CAM LOCK: " .. (enabled and "ON" or "OFF")
	cameraFloat.Text = "CAM LOCK: " .. (enabled and "ON" or "OFF")
	statusLabel.Text = enabled and "STATUS: CAMERA LOCK ON" or "STATUS: READY"

	if cameraConnection then
		cameraConnection:Disconnect()
		cameraConnection = nil
	end

	if enabled then
		cameraConnection = RunService:BindToRenderStep(
			"NeonCyberCameraLock",
			Enum.RenderPriority.Camera.Value + 1,
			function()
				if destroyed or not cameraLock then
					return
				end

				local target = selectedPlayer
				local targetCharacter = target and target.Character
				local targetPart = targetCharacter and (
					targetCharacter:FindFirstChild("Head")
					or targetCharacter:FindFirstChild("HumanoidRootPart")
				)
				local camera = workspace.CurrentCamera

				if targetPart and camera then
					local currentPosition = camera.CFrame.Position
					camera.CFrame = CFrame.lookAt(
						currentPosition,
						targetPart.Position
					)
				end
			end
		)
	end
end

--// SMOOTH FOLLOW / START MOVE
-- Follows behind and above the target, including while they jump or fall.
-- This is a local client movement effect; server physics may override it.

local function setFollow(enabled)
	followEnabled = enabled
	followPanelButton.Text = "START MOVE: " .. (enabled and "ON" or "OFF")
	moveFloat.Text = "START MOVE: " .. (enabled and "ON" or "OFF")
	statusLabel.Text = enabled and "STATUS: FOLLOWING TARGET" or "STATUS: READY"

	if followConnection then
		followConnection:Disconnect()
		followConnection = nil
	end

	if enabled then
		followConnection = RunService.Heartbeat:Connect(function(dt)
			if destroyed or not followEnabled then
				return
			end

			local targetRoot = getRoot(selectedPlayer)
			local myRoot = getRoot(LocalPlayer)

			if not targetRoot or not myRoot then
				return
			end

			-- Offset is relative to the target's full 3D orientation.
			-- Positive Z places the follower behind the target.
			local goal = targetRoot.CFrame * CFrame.new(0, 3, 5)
			local alpha = 1 - math.exp(-5 * math.clamp(dt, 0, 0.1))

			myRoot.CFrame = myRoot.CFrame:Lerp(goal, alpha)
			myRoot.AssemblyLinearVelocity = targetRoot.AssemblyLinearVelocity
		end)
	end
end

--// LOOP NOCLIP
-- Client-side collision toggle for testing in your own experience.

local function setNoclip(enabled)
	loopNoclip = enabled
	noclipButton.Text = "LOOP NOCLIP: " .. (enabled and "ON" or "OFF")
	statusLabel.Text = enabled and "STATUS: NOCLIP ON" or "STATUS: READY"

	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end

	if enabled then
		noclipConnection = RunService.Stepped:Connect(function()
			if destroyed or not loopNoclip then
				return
			end

			local character = getCharacter()
			if not character then
				return
			end

			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					if originalCollisions[part] == nil then
						originalCollisions[part] = part.CanCollide
					end
					part.CanCollide = false
				end
			end
		end)
	else
		for part, canCollide in pairs(originalCollisions) do
			if part and part.Parent then
				part.CanCollide = canCollide
			end
		end
		table.clear(originalCollisions)
	end
end

