-- Follow controller: smooth 3D following behind target.
local function stopFollow()
	following = false

	if followConnection then
		followConnection:Disconnect()
		followConnection = nil
	end
	if alignPosition then
		alignPosition:Destroy()
		alignPosition = nil
	end
	if followAttachment then
		followAttachment:Destroy()
		followAttachment = nil
	end

	local hum = humanoidOf(player)
	if hum then
		hum.PlatformStand = oldPlatformStand or false
		hum.AutoRotate = oldAutoRotate ~= false
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end

	moveButton.Text = "START MOVE"
	floatingMoveButton.Text = "START MOVE"
end

local function startFollow()
	local myRoot = rootOf(player)
	local myHumanoid = humanoidOf(player)
	local targetRoot = rootOf(targetPlayer)

	if not myRoot or not myHumanoid or not targetRoot then
		hint.Text = "Select a spawned target first"
		return
	end

	stopFollow()
	following = true
	oldPlatformStand = myHumanoid.PlatformStand
	oldAutoRotate = myHumanoid.AutoRotate
	myHumanoid.AutoRotate = false

	followAttachment = Instance.new("Attachment")
	followAttachment.Name = "CyberFollowAttachment"
	followAttachment.Parent = myRoot

	alignPosition = Instance.new("AlignPosition")
	alignPosition.Name = "CyberFollowPosition"
	alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
	alignPosition.Attachment0 = followAttachment
	alignPosition.ApplyAtCenterOfMass = true
	alignPosition.RigidityEnabled = false
	alignPosition.Responsiveness = 10
	alignPosition.MaxForce = 1000000
	alignPosition.MaxVelocity = speed
	alignPosition.Position = myRoot.Position
	alignPosition.Parent = myRoot

	moveButton.Text = "STOP MOVE"
	floatingMoveButton.Text = "STOP MOVE"

	followConnection = RunService.Heartbeat:Connect(function()
		if not following then return end

		local targetRootNow = rootOf(targetPlayer)
		if not targetRootNow or not alignPosition then
			stopFollow()
			return
		end

		-- Follow behind the target and match their vertical position.
		alignPosition.Position = targetRootNow.CFrame:PointToWorldSpace(
			Vector3.new(0, 0, 4)
		)
		alignPosition.MaxVelocity = speed
	end)
end

local function toggleFollow()
	if following then
		stopFollow()
	else
		startFollow()
	end
end

moveButton.Activated:Connect(toggleFollow)

floatingMoveButton.Activated:Connect(function()
	if not canClick(floatingMoveButton) then return end
	toggleFollow()
end)

-- Third-person camera tracking
local function stopCamera()
	cameraLocked = false

	if cameraConnection then
		cameraConnection:Disconnect()
		cameraConnection = nil
	end

	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = savedCameraType or Enum.CameraType.Custom
		if savedCameraSubject and savedCameraSubject.Parent then
			camera.CameraSubject = savedCameraSubject
		end
	end

	savedCameraType = nil
	savedCameraSubject = nil
	camButton.Text = "CAM LOCK: OFF"
end

local function startCamera()
	if not rootOf(targetPlayer) then
		hint.Text = "Select a spawned target first"
		return
	end

	local camera = workspace.CurrentCamera
	local hum = humanoidOf(player)
	if not camera or not hum then return end

	savedCameraType = camera.CameraType
	savedCameraSubject = camera.CameraSubject
	cameraLocked = true
	camera.CameraType = Enum.CameraType.Scriptable
	camButton.Text = "CAM LOCK: ON"

	cameraConnection = RunService.RenderStepped:Connect(function(dt)
		local myRoot = rootOf(player)
		local targetRoot = rootOf(targetPlayer)
		camera = workspace.CurrentCamera

		if not cameraLocked or not myRoot or not targetRoot or not camera then
			return
		end

		local cameraPosition = myRoot.Position
			- myRoot.CFrame.LookVector * 10
			+ Vector3.new(0, 4, 0)

		local lookPosition = targetRoot.Position + Vector3.new(0, 1.5, 0)
		local desired = CFrame.lookAt(cameraPosition, lookPosition)
		camera.CFrame = camera.CFrame:Lerp(
			desired,
			1 - math.exp(-5 * dt)
		)
	end)
end

camButton.Activated:Connect(function()
	if not canClick(camButton) then return end

	if cameraLocked then
		stopCamera()
	else
		startCamera()
	end
end)

-- Loop noclip for the local character.
local function restoreCollisions()
	for part, previousValue in pairs(originalCollisions) do
		if part and part.Parent then
			part.CanCollide = previousValue
		end
	end
	table.clear(originalCollisions)
end

local function applyNoclip(character)
	for _, obj in ipairs(character:GetDescendants()) do
		if obj:IsA("BasePart") then
			if originalCollisions[obj] == nil then
				originalCollisions[obj] = obj.CanCollide
			end
			obj.CanCollide = false
		end
	end
end

noclipButton.Activated:Connect(function()
	noclip = not noclip
	noclipButton.Text = noclip and "LOOP NOCLIP: ON" or "LOOP NOCLIP: OFF"

	if noclip then
		local character = player.Character
		if character then applyNoclip(character) end

		if characterCollisionConnection then
			characterCollisionConnection:Disconnect()
		end

		characterCollisionConnection = RunService.Stepped:Connect(function()
			if noclip and player.Character then
				applyNoclip(player.Character)
			end
		end)
	else
		if characterCollisionConnection then
			characterCollisionConnection:Disconnect()
			characterCollisionConnection = nil
		end
		restoreCollisions()
	end
end)

local function destroyEverything()
	if following then stopFollow() end
	if cameraLocked then stopCamera() end

	noclip = false
	if characterCollisionConnection then
		characterCollisionConnection:Disconnect()
		characterCollisionConnection = nil
	end
	restoreCollisions()
	gui:Destroy()
end

destroyButton.Activated:Connect(destroyEverything)

