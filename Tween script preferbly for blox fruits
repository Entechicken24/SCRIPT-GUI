-- Smooth 3D follow controller
local function stopFollow()
	following = false

	if followConnection then
		followConnection:Disconnect()
		followConnection = nil
	end

	if alignPosition then
		alignPosition:Destroy()
		alignPosition = nil
	end

	if followAttachment then
		followAttachment:Destroy()
		followAttachment = nil
	end

	local hum = humanoidOf(player)
	if hum then
		hum.PlatformStand = oldPlatformStand or false
		hum.AutoRotate = oldAutoRotate ~= false
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end

	moveButton.Text = "START MOVE"
end

local function startFollow()
	local myCharacter = characterOf(player)
	local myRoot = rootOf(player)
	local myHumanoid = humanoidOf(player)
	local targetRoot = rootOf(targetPlayer)

	if not myCharacter or not myRoot or not myHumanoid or not targetRoot then
		note.Text = "Both characters must be spawned"
		return
	end

	if myRoot.Anchored then
		note.Text = "Your character root is anchored"
		return
	end

	stopFollow()

	following = true
	oldPlatformStand = myHumanoid.PlatformStand
	oldAutoRotate = myHumanoid.AutoRotate
	myHumanoid.AutoRotate = false

	followAttachment = Instance.new("Attachment")
	followAttachment.Name = "CyberFollowAttachment"
	followAttachment.Parent = myRoot

	alignPosition = Instance.new("AlignPosition")
	alignPosition.Name = "CyberFollowPosition"
	alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
	alignPosition.Attachment0 = followAttachment
	alignPosition.ApplyAtCenterOfMass = true
	alignPosition.RigidityEnabled = false
	alignPosition.Responsiveness = 10
	alignPosition.MaxForce = 1000000
	alignPosition.MaxVelocity = speed
	alignPosition.Position = myRoot.Position
	alignPosition.Parent = myRoot

	moveButton.Text = "STOP MOVE"

	followConnection = RunService.Heartbeat:Connect(function()
		if not following then return end

		local currentRoot = rootOf(player)
		local currentTarget = rootOf(targetPlayer)
		if not currentRoot or not currentTarget or not alignPosition then
			stopFollow()
			return
		end

		-- Local +Z is behind the target's facing direction.
		-- This destination includes the target's vertical position.
		local destination = currentTarget.CFrame:PointToWorldSpace(
			Vector3.new(0, followHeight, followDistance)
		)

		alignPosition.Position = destination
		alignPosition.MaxVelocity = speed
	end)
end

moveButton.Activated:Connect(function()
	if not moveCanClick() then return end

	if following then
		stopFollow()
	else
		startFollow()
	end
end)

-- Third-person camera lock: camera remains behind YOUR character,
-- while smoothly looking toward the selected target.
local function stopCamera()
	cameraLocked = false

	if cameraConnection then
		cameraConnection:Disconnect()
		cameraConnection = nil
	end

	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = oldCameraType or Enum.CameraType.Custom
		if oldCameraSubject and oldCameraSubject.Parent then
			camera.CameraSubject = oldCameraSubject
		end
	end

	oldCameraType = nil
	oldCameraSubject = nil
	camButton.Text = "CAM LOCK: OFF"
end

local function startCamera()
	if not rootOf(targetPlayer) then
		note.Text = "Select a spawned player first"
		return
	end

	local camera = workspace.CurrentCamera
	local myHumanoid = humanoidOf(player)
	if not camera or not myHumanoid then return end

	oldCameraType = camera.CameraType
	oldCameraSubject = camera.CameraSubject
	cameraLocked = true
	camera.CameraType = Enum.CameraType.Scriptable
	camButton.Text = "CAM LOCK: ON"

	cameraConnection = RunService.RenderStepped:Connect(function(dt)
		if not cameraLocked then return end

		local myRoot = rootOf(player)
		local targetRoot = rootOf(targetPlayer)
		camera = workspace.CurrentCamera

		if not myRoot or not targetRoot or not camera then return end

		local cameraPosition = myRoot.Position
			- myRoot.CFrame.LookVector * 10
			+ Vector3.new(0, 4, 0)
		local lookPosition = targetRoot.Position + Vector3.new(0, 1.5, 0)
		local desired = CFrame.lookAt(cameraPosition, lookPosition)

		camera.CFrame = camera.CFrame:Lerp(
			desired,
			1 - math.exp(-5 * dt)
		)
	end)
end

camButton.Activated:Connect(function()
	if not camCanClick() then return end

	if cameraLocked then
		stopCamera()
	else
		startCamera()
	end
end)

