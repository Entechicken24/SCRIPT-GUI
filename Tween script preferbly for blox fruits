-- CAMERA FUNCTIONS
local function updateCameraLabel()
    cameraButton.Text = cameraLocked
        and "CAMERA LOCK: ON"
        or "CAMERA LOCK: OFF"

    cameraButton.TextColor3 = cameraLocked and CYAN or MUTED
end

local function updateZoomLabel()
    zoomLabel.Text = "Camera distance: "
        .. tostring(math.floor(desiredDistance))
end

local function changeZoom(amount)
    desiredDistance = math.clamp(
        desiredDistance + amount,
        MIN_DISTANCE,
        MAX_DISTANCE
    )

    updateZoomLabel()
end

local function stopCameraLock()
    if not cameraLocked then
        return
    end

    cameraLocked = false
    RunService:UnbindFromRenderStep(CAMERA_BIND)

    local camera = workspace.CurrentCamera
    local _, localHumanoid = getCharacterParts(me)

    if camera then
        if savedCameraType then
            camera.CameraType = savedCameraType
        else
            camera.CameraType = Enum.CameraType.Custom
        end

        -- Prefer the current character's Humanoid after a respawn.
        if localHumanoid then
            camera.CameraSubject = localHumanoid
        elseif savedCameraSubject
            and savedCameraSubject.Parent then
            camera.CameraSubject = savedCameraSubject
        end

        if savedCameraCFrame then
            camera.CFrame = savedCameraCFrame
        end
    end

    activeCamera = nil
    savedCameraType = nil
    savedCameraSubject = nil
    savedCameraCFrame = nil

    currentPosition = nil
    currentLook = nil

    updateCameraLabel()
end

local function startCameraLock(target)
    if not target or target == me then
        return false
    end

    if cameraLocked then
        stopCameraLock()
    end

    local camera = workspace.CurrentCamera
    if not camera then
        status.Text = "Camera unavailable"
        return false
    end

    savedCameraType = camera.CameraType
    savedCameraSubject = camera.CameraSubject
    savedCameraCFrame = camera.CFrame

    activeCamera = camera
    currentDistance = desiredDistance
    currentPosition = camera.CFrame.Position
    currentLook = camera.CFrame.LookVector

    cameraLocked = true
    camera.CameraType = Enum.CameraType.Scriptable
    updateCameraLabel()

    RunService:BindToRenderStep(
        CAMERA_BIND,
        Enum.RenderPriority.Camera.Value + 1,
        function(dt)
            if not cameraLocked then
                return
            end

            local currentCamera = workspace.CurrentCamera
            if not currentCamera then
                return
            end

            -- Roblox can replace the camera during respawn.
            if currentCamera ~= activeCamera then
                activeCamera = currentCamera
                currentPosition = currentCamera.CFrame.Position
                currentLook = currentCamera.CFrame.LookVector
            end

            local _, _, localRoot = getCharacterParts(me)
            local _, _, targetRoot = getCharacterParts(target)

            -- Wait for either character to become available again.
            if not localRoot or not targetRoot then
                return
            end

            currentCamera.CameraType = Enum.CameraType.Scriptable

            local zoomAlpha = 1 - math.exp(-ZOOM_SMOOTHNESS * dt)
            currentDistance = currentDistance
                + (desiredDistance - currentDistance) * zoomAlpha

            -- Camera follows YOUR character while looking at the target.
            local desiredPosition =
                localRoot.Position
                - localRoot.CFrame.LookVector * currentDistance
                + Vector3.new(0, CAMERA_HEIGHT, 0)

            local aimPoint = targetRoot.Position
                + Vector3.new(0, AIM_HEIGHT, 0)

            local offset = aimPoint - desiredPosition
            if offset.Magnitude < 0.001 then
                return
            end

            local desiredLook = offset.Unit

            local positionAlpha =
                1 - math.exp(-POSITION_SMOOTHNESS * dt)

            local rotationAlpha =
                1 - math.exp(-ROTATION_SMOOTHNESS * dt)

            currentPosition = currentPosition:Lerp(
                desiredPosition,
                positionAlpha
            )

            currentLook = currentLook:Lerp(
                desiredLook,
                rotationAlpha
            )

            if currentLook.Magnitude > 0.001 then
                currentCamera.CFrame = CFrame.lookAt(
                    currentPosition,
                    currentPosition + currentLook.Unit
                )
            end
        end
    )

    return true
end

-- NOCLIP
local function restoreCollisions()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end

    for part, original in pairs(originalCollisions) do
        if part and part.Parent then
            part.CanCollide = original
        end
    end

    table.clear(originalCollisions)
end

local function applyNoclip(character)
    restoreCollisions()

    if not running or not character then
        return
    end

    local function disableCollision(part)
        if not part:IsA("BasePart") or not running then
            return
        end

        if originalCollisions[part] == nil then
            originalCollisions[part] = part.CanCollide
        end

        part.CanCollide = false
    end

    for _, part in ipairs(character:GetDescendants()) do
        disableCollision(part)
    end

    noclipConnection = RunService.Stepped:Connect(function()
        if not running then
            return
        end

        local characterNow = me.Character
        if not characterNow then
            return
        end

        for _, part in ipairs(characterNow:GetDescendants()) do
            disableCollision(part)
        end
    end)
end

