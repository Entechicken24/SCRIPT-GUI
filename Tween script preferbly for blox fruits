--========================================================
-- DRAG PANEL WITH TOUCH OR MOUSE
--========================================================

local panelDragging = false
local panelDragStart
local panelStartPosition
local dragInput

header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
		panelDragging = true
		panelDragStart = input.Position
		panelStartPosition = main.Position
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not panelDragging then return end

	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - panelDragStart
		local camera = workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize

		local newX = panelStartPosition.X.Offset + delta.X
		local newY = panelStartPosition.Y.Offset + delta.Y

		if viewport then
			newX = math.clamp(newX, 0, math.max(0, viewport.X - main.AbsoluteSize.X))
			newY = math.clamp(newY, main.AbsoluteSize.Y / 2,
				math.max(main.AbsoluteSize.Y / 2, viewport.Y - main.AbsoluteSize.Y / 2))
		end

		main.Position = UDim2.new(0, newX, 0.5, newY - (viewport and viewport.Y / 2 or 0))
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input == dragInput
		or input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
		panelDragging = false
	end
end)

