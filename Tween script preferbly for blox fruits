-- Mobile + mouse drag handler. Buttons are clamped to the visible screen.
local function makeDraggable(b)
	local dragging = false
	local startPosition
	local startPointer
	local activeInput
	local touchId
	local moved = false
	local suppressClick = false

	local function clamp(x, y)
		local camera = workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
		x = math.clamp(x, 0, math.max(0, viewport.X - b.AbsoluteSize.X))
		y = math.clamp(y, 0, math.max(0, viewport.Y - b.AbsoluteSize.Y))
		return x, y
	end

	b.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch
			and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end

		dragging = true
		moved = false
		activeInput = input
		touchId = input.UserInputType == Enum.UserInputType.Touch
			and input.TouchId or nil
		startPointer = input.Position
		startPosition = b.AbsolutePosition
	end)

	UIS.InputChanged:Connect(function(input)
		if not dragging then return end

		local isMouseMove = input.UserInputType == Enum.UserInputType.MouseMovement
			and activeInput
			and activeInput.UserInputType == Enum.UserInputType.MouseButton1

		local isTouchMove = input.UserInputType == Enum.UserInputType.Touch
			and touchId ~= nil and input.TouchId == touchId

		if not isMouseMove and not isTouchMove then return end

		local delta = input.Position - startPointer
		if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
			moved = true
		end

		local x, y = clamp(
			startPosition.X + delta.X,
			startPosition.Y + delta.Y
		)
		b.Position = UDim2.fromOffset(x, y)
	end)

	UIS.InputEnded:Connect(function(input)
		local mouseEnd = input.UserInputType == Enum.UserInputType.MouseButton1
			and activeInput
			and activeInput.UserInputType == Enum.UserInputType.MouseButton1
		local touchEnd = input.UserInputType == Enum.UserInputType.Touch
			and touchId ~= nil and input.TouchId == touchId

		if dragging and (mouseEnd or touchEnd) then
			dragging = false
			activeInput = nil
			touchId = nil
			if moved then
				suppressClick = true
				task.delay(0.25, function()
					suppressClick = false
				end)
			end
		end
	end)

	return function()
		if suppressClick then
			suppressClick = false
			return false
		end
		return true
	end
end

