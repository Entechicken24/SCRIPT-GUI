--==================================================
-- PLAYER SELECTOR
--==================================================

local function refreshPlayers()
	for _, child in ipairs(playerList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local list = Players:GetPlayers()
	table.sort(list, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)

	for _, player in ipairs(list) do
		local entry = make("TextButton", {
			Name = player.Name,
			Size = UDim2.new(1, -4, 0, 30),
			BackgroundColor3 = player == selectedPlayer
				and Color3.fromRGB(64, 49, 25) or PANEL,
			BorderSizePixel = 0,
			Text = "  " .. player.DisplayName .. "  (@" .. player.Name .. ")",
			TextColor3 = player == selectedPlayer and PALE_GOLD or WHITE,
			TextSize = 11,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left
		}, playerList)
		corner(entry, 6)

		entry.Activated:Connect(function()
			selectedPlayer = player
			targetLabel.Text = "TARGET: " .. player.DisplayName
			refreshPlayers()
		end)
	end

	if selectedPlayer and selectedPlayer.Parent == Players then
		targetLabel.Text = "TARGET: " .. selectedPlayer.DisplayName
	else
		targetLabel.Text = "TARGET: NONE"
	end
end

Players.PlayerAdded:Connect(refreshPlayers)
Players.PlayerRemoving:Connect(function(player)
	if player == selectedPlayer then
		selectedPlayer = nil
	end
	refreshPlayers()
end)

refreshPlayers()

--==================================================
-- MOVEMENT
--==================================================

local function removeVelocity()
	if velocityConstraint then
		velocityConstraint:Destroy()
		velocityConstraint = nil
	end
	if rootAttachment then
		rootAttachment:Destroy()
		rootAttachment = nil
	end
	activeRoot = nil
end

local function stopMovement(message)
	movementActive = false
	removeVelocity()
	moveButton.Text = "START MOVE"
	statusLabel.Text = message or "MOVEMENT STOPPED"
end

local function setupVelocity(root)
	removeVelocity()
	activeRoot = root

	rootAttachment = make("Attachment", {
		Name = "NeonTravelAttachment"
	}, root)

	velocityConstraint = make("LinearVelocity", {
		Name = "NeonTravelVelocity",
		Attachment0 = rootAttachment,
		RelativeTo = Enum.ActuatorRelativeTo.World,
		VelocityConstraintMode = Enum.VelocityConstraintMode.Vector,
		VectorVelocity = Vector3.zero,
		ForceLimitsEnabled = false
	}, root)
end

local function startMovement()
	if not selectedPlayer or selectedPlayer == LocalPlayer then
		statusLabel.Text = "SELECT ANOTHER PLAYER"
		return
	end

	local _, myRoot = getParts(LocalPlayer)
	local _, targetRoot = getParts(selectedPlayer)

	if not myRoot or not targetRoot then
		statusLabel.Text = "CHARACTER NOT READY"
		return
	end

	movementActive = true
	moveButton.Text = "STOP MOVE"
	setupVelocity(myRoot)
end

moveButton.Activated:Connect(function()
	if movementActive then
		stopMovement()
	else
		startMovement()
	end
end)

RunService.Heartbeat:Connect(function()
	if not movementActive then return end

	local _, myRoot = getParts(LocalPlayer)
	local _, targetRoot = getParts(selectedPlayer)

	if not myRoot or not targetRoot then
		stopMovement("CHARACTER OR TARGET UNAVAILABLE")
		return
	end

	if myRoot ~= activeRoot or not velocityConstraint then
		setupVelocity(myRoot)
	end

	local destination = targetRoot.Position
		- targetRoot.CFrame.LookVector * FOLLOW_DISTANCE

	local offset = destination - myRoot.Position
	local distance = offset.Magnitude

	if distance < 0.5 then
		velocityConstraint.VectorVelocity = Vector3.zero
	else
		local speed = math.min(travelSpeed, distance * 4)
		velocityConstraint.VectorVelocity = offset.Unit * speed
	end

	statusLabel.Text = "MOVING • " .. travelSpeed .. " SPS"
end)

--==================================================
-- RESPONSIVE CAMERA TRACK
--
-- Important: this does NOT write Camera.CFrame every frame.
-- It uses a temporary camera subject offset, leaving Roblox's
-- normal camera controller and mouse input enabled.
--==================================================

local originalCameraSubject
local cameraOffset = Vector3.zero
local cameraHumanoid
local cameraOriginalOffset

local function stopCameraTracking()
	cameraTracking = false

	if cameraConnection then
		cameraConnection:Disconnect()
		cameraConnection = nil
	end

	if cameraHumanoid and cameraHumanoid.Parent and cameraOriginalOffset then
		cameraHumanoid.CameraOffset = cameraOriginalOffset
	end

	cameraHumanoid = nil
	cameraOriginalOffset = nil

	cameraButton.Text = "CAMERA: OFF"
	statusLabel.Text = "CAMERA TRACK OFF"
end

local function startCameraTracking()
	if not selectedPlayer or selectedPlayer == LocalPlayer then
		statusLabel.Text = "SELECT A TARGET FOR CAMERA"
		return
	end

	local myHumanoid = getParts(LocalPlayer)
	if not myHumanoid then
		statusLabel.Text = "YOUR CHARACTER IS NOT READY"
		return
	end

	cameraTracking = true
	cameraHumanoid = myHumanoid
	cameraOriginalOffset = myHumanoid.CameraOffset

	cameraButton.Text = "CAMERA: ON"

	cameraConnection = RunService.RenderStepped:Connect(function(dt)
		if not cameraTracking then return end

		local targetHumanoid, targetRoot = getParts(selectedPlayer)
		local _, currentRoot = getParts(LocalPlayer)

		if not targetRoot or not currentRoot or not cameraHumanoid then
			return
		end

		-- The standard camera keeps responding to mouse input.
		-- CameraOffset is blended gently rather than hard-locking the view.
		local localDirection = currentRoot.CFrame:VectorToObjectSpace(
			targetRoot.Position - currentRoot.Position
		)

		local desiredOffset = Vector3.new(
			math.clamp(localDirection.X * 0.05, -2, 2),
			math.clamp(localDirection.Y * 0.025, -1, 1),
			0
		)

		local alpha = 1 - math.exp(-CAMERA_SMOOTHNESS * dt)
		cameraOffset = cameraOffset:Lerp(desiredOffset, alpha)

		cameraHumanoid.CameraOffset = cameraOriginalOffset + cameraOffset
	end)
end

cameraButton.Activated:Connect(function()
	if cameraTracking then
		stopCameraTracking()
	else
		startCameraTracking()
	end
end)

