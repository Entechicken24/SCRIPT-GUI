--// FOLLOW SYSTEM RAYCAST SETUP
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = false

local function getSafeDestination(targetRoot, localCharacter, targetHumanoid)
    local targetPosition = targetRoot.Position
    local localRoot = getRoot(LocalPlayer)

    if not localRoot then
        return nil
    end

    local offset = targetRoot.CFrame.LookVector * CONFIG.FOLLOW_DISTANCE
    local desiredX = targetPosition.X + offset.X
    local desiredZ = targetPosition.Z + offset.Z

    if targetHumanoid
        and targetHumanoid.FloorMaterial == Enum.Material.Air then

        return Vector3.new(desiredX, targetPosition.Y, desiredZ)
    end

    local desired = Vector3.new(
        desiredX,
        localRoot.Position.Y,
        desiredZ
    )

    rayParams.FilterDescendantsInstances = {
        localCharacter,
        getCharacter(selectedPlayer),
    }

    local origin = desired + Vector3.new(0, 5, 0)
    local result = workspace:Raycast(
        origin,
        Vector3.new(0, -CONFIG.GROUND_RAY_LENGTH, 0),
        rayParams
    )

    if not result then
        return nil
    end

    local currentGround = workspace:Raycast(
        localRoot.Position + Vector3.new(0, 3, 0),
        Vector3.new(0, -CONFIG.GROUND_RAY_LENGTH, 0),
        rayParams
    )

    if currentGround then
        local heightDifference = math.abs(
            result.Position.Y - currentGround.Position.Y
        )

        if heightDifference > CONFIG.MAX_GROUND_HEIGHT_DIFFERENCE then
            return nil
        end
    end

    local humanoid = getHumanoid(LocalPlayer)
    local standingHeight = 3

    if humanoid then
        standingHeight = humanoid.HipHeight + localRoot.Size.Y / 2
    end

    return Vector3.new(
        desired.X,
        result.Position.Y + standingHeight,
        desired.Z
    )
end

--// MOVEMENT CONSTRAINT CLEANUP
local function clearMovementConstraint()
    if moveVelocity then
        moveVelocity:Destroy()
        moveVelocity = nil
    end

    if moveAttachment then
        moveAttachment:Destroy()
        moveAttachment = nil
    end

    moveRoot = nil
    currentVelocity = Vector3.zero
end

local function stopMovementConstraint()
    clearMovementConstraint()
end

--// CREATE MOVEMENT CONTROLLER
local function createMovementConstraint(root)
    clearMovementConstraint()

    moveRoot = root

    moveAttachment = Instance.new("Attachment")
    moveAttachment.Name = "NeonFollowAttachment"
    moveAttachment.Parent = root

    moveVelocity = Instance.new("LinearVelocity")
    moveVelocity.Name = "NeonFollowVelocity"
    moveVelocity.Attachment0 = moveAttachment
    moveVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    moveVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    moveVelocity.ForceLimitsEnabled = false
    moveVelocity.VectorVelocity = Vector3.zero
    moveVelocity.Parent = root

    currentVelocity = Vector3.zero
end

local function setFollowEnabled(enabled)
    followEnabled = enabled

    if enabled then
        followButton.Text = "■  STOP MOVE"
        floatingFollow.Text = "■ STOP MOVE"
        followButton.TextColor3 = RED
        floatingFollow.TextColor3 = RED

        statusText.Text = "FOLLOW ACTIVE"
        statusText.TextColor3 = GREEN
    else
        stopMovementConstraint()

        followButton.Text = "▶  START MOVE"
        floatingFollow.Text = "▶ START MOVE"
        followButton.TextColor3 = GREEN
        floatingFollow.TextColor3 = GREEN

        statusText.Text = "SYSTEM ONLINE"
        statusText.TextColor3 = GREEN
    end
end

local function toggleFollow()
    if followEnabled then
        setFollowEnabled(false)
        return
    end

    if not selectedPlayer or not getRoot(selectedPlayer) then
        statusText.Text = "SELECT A VALID PLAYER FIRST"
        statusText.TextColor3 = RED
        return
    end

    local localRoot = getRoot(LocalPlayer)
    local localHumanoid = getHumanoid(LocalPlayer)

    if not localRoot or not localHumanoid
        or localHumanoid.Health <= 0 then

        statusText.Text = "CHARACTER UNAVAILABLE"
        statusText.TextColor3 = RED
        return
    end

    createMovementConstraint(localRoot)
    setFollowEnabled(true)
end

followButton.Activated:Connect(toggleFollow)
floatingFollow.Activated:Connect(toggleFollow)

