        return
    end

    local card = Instance.new("TextButton")
    card.Name = "Target_" .. p.UserId
    card.Size = UDim2.new(1, -3, 0, 46)
    card.BackgroundColor3 = Color3.fromRGB(34, 34, 39)
    card.Text = ""
    card.AutoButtonColor = true
    card.Parent = playerScroll
    corner(card, 8)
    stroke(card, Color3.fromRGB(100, 79, 43), 1)

    local avatar = Instance.new("ImageLabel")
    avatar.Size = UDim2.fromOffset(34, 34)
    avatar.Position = UDim2.fromOffset(6, 6)
    avatar.BackgroundColor3 = DARK
    avatar.BorderSizePixel = 0
    avatar.Parent = card
    corner(avatar, 7)

    local name = label(
        card,
        p.DisplayName .. "\n@" .. p.Name,
        UDim2.new(1, -50, 1, 0),
        UDim2.fromOffset(46, 0),
        12
    )
    name.TextXAlignment = Enum.TextXAlignment.Left

    cards[p] = card

    task.spawn(function()
        local ok, image = pcall(function()
            return Players:GetUserThumbnailAsync(
                p.UserId,
                Enum.ThumbnailType.HeadShot,
                Enum.ThumbnailSize.Size100x100
            )
        end)

        if ok and avatar.Parent then
            avatar.Image = image
        end
    end)

    card.Activated:Connect(function()
        selectPlayer(p)
    end)

    refreshHighlights()
end

local function removePlayer(p)
    if cards[p] then
        cards[p]:Destroy()
        cards[p] = nil
    end

    if selectedPlayer == p then
        selectedPlayer = nil
        refreshHighlights()
        setStatus("Target left the server")
    end
end

