--========================================================
-- DESTROY GUI
--========================================================

local function destroyEverything()
	if destroyed then
		return
	end

	-- Restore character settings before deleting the UI.
	setFollowing(false)
	setCameraLock(false)
	setNoclip(false)

	destroyed = true

	pcall(function()
		RunService:UnbindFromRenderStep("NeonCyberCameraLock")
	end)

	if cameraConnection then
		cameraConnection:Disconnect()
		cameraConnection = nil
	end

	if followConnection then
		followConnection:Disconnect()
		followConnection = nil
	end

	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end

	local humanoid = getHumanoid()
	if humanoid and savedWalkSpeed ~= nil then
		humanoid.WalkSpeed = savedWalkSpeed
	end

	for _, connection in ipairs(connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	table.clear(connections)

	gui:Destroy()
end

connect(destroyButton.Activated, destroyEverything)

