draggable(aimButton, aimButton)

local function stopAim()
    aimEnabled = false

    if aimConnection then
        aimConnection:Disconnect()
        aimConnection = nil
    end

    local camera = workspace.CurrentCamera
    if camera then
        camera.CameraType = savedCameraType or Enum.CameraType.Custom
        if savedCameraSubject and savedCameraSubject.Parent then
            camera.CameraSubject = savedCameraSubject
        end
    end

    aimButton.Text = "AIM LOCK: OFF"
    aimButton.BackgroundColor3 = Theme.Panel
end

aimButton.Activated:Connect(function()
    if aimEnabled then
        stopAim()
        return
    end

    if not selectedPlayer then
        status.Text = "STATUS: SELECT A PLAYER"
        status.TextColor3 = Theme.Red
        return
    end

    local camera = workspace.CurrentCamera
    if not camera then return end

    savedCameraType = camera.CameraType
    savedCameraSubject = camera.CameraSubject
    camera.CameraType = Enum.CameraType.Scriptable

    aimEnabled = true
    aimButton.Text = "AIM LOCK: ON"
    aimButton.BackgroundColor3 = Theme.Green

    aimConnection = game:GetService("RunService").RenderStepped:Connect(function()
        local targetRoot = getRoot(selectedPlayer)
        if not targetRoot then
            stopAim()
            return
        end

        local currentCamera = workspace.CurrentCamera
        if currentCamera then
            currentCamera.CFrame = CFrame.lookAt(
                currentCamera.CFrame.Position,
                targetRoot.Position
            )
        end
    end)
end)

