local function refreshRoster()
    for _, child in ipairs(roster:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    rosterButtons = {}

    local playerList = Players:GetPlayers()

    table.sort(playerList, function(a, b)
        local aName = a.DisplayName:lower()
        local bName = b.DisplayName:lower()

        if aName == bName then
            return a.Name:lower() < b.Name:lower()
        end

        return aName < bName
    end)

    for _, targetPlayer in ipairs(playerList) do
        if targetPlayer ~= LocalPlayer then
            local entry = button(
                roster,
                "  " .. targetPlayer.DisplayName,
                UDim2.new(1, -6, 0, 25),
                UDim2.new(),
                targetPlayer == selectedPlayer and GREEN or CYAN
            )

            entry.TextXAlignment = Enum.TextXAlignment.Left
            entry.LayoutOrder = #rosterButtons + 1
            rosterButtons[targetPlayer] = entry

            entry.Activated:Connect(function()
                selectedPlayer = targetPlayer
                updateSelectedDisplay()
                refreshRoster()
            end)

            if targetPlayer == selectedPlayer then
                entry.BackgroundColor3 = Color3.fromRGB(17, 60, 62)
            end
        end
    end

    updateSelectedDisplay()
end

