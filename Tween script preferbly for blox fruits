-- STOP FOLLOW AND CAMERA TOGETHER
local function cleanup()
    running = false

    if loop then
        loop:Disconnect()
        loop = nil
    end

    stopCameraLock()
    restoreCollisions()

    if force then
        force:Destroy()
        force = nil
    end

    if attachment then
        attachment:Destroy()
        attachment = nil
    end

    local character = me.Character
    local humanoid = character
        and character:FindFirstChildOfClass("Humanoid")

    if humanoid and oldAutoRotate ~= nil then
        humanoid.AutoRotate = oldAutoRotate
    end

    controlledRoot = nil
    oldAutoRotate = nil

    updateQuick()
end

-- CREATE MOVEMENT OBJECTS FOR CURRENT CHARACTER
local function attachMovement(character)
    if not running or not character then
        return false
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        return false
    end

    if force then
        force:Destroy()
        force = nil
    end

    if attachment then
        attachment:Destroy()
        attachment = nil
    end

    controlledRoot = root
    oldAutoRotate = humanoid.AutoRotate
    humanoid.AutoRotate = false

    attachment = Instance.new("Attachment")
    attachment.Name = "LocalFollowAttachment"
    attachment.Parent = root

    force = Instance.new("VectorForce")
    force.Name = "LocalFollowAntiGravity"
    force.Attachment0 = attachment
    force.RelativeTo = Enum.ActuatorRelativeTo.World
    force.ApplyAtCenterOfMass = true
    force.Parent = root

    applyNoclip(character)

    return true
end

-- START FOLLOW + CAMERA LOCK ON THE SAME TARGET
local function startFollowing(target)
    if not target or target == me or target.Parent ~= Players then
        status.Text = "Select another player"
        return
    end

    local _, humanoid, root = getCharacterParts(me)
    local _, _, targetRoot = getCharacterParts(target)

    if not humanoid or not root then
        status.Text = "Your character isn't ready"
        return
    end

    if not targetRoot then
        status.Text = "Target character isn't ready"
        return
    end

    if running then
        cleanup()
    end

    selected = target

    speed = math.clamp(
        tonumber(speedBox.Text) or SPEED_MAX,
        5,
        SPEED_MAX
    )

    speedBox.Text = tostring(speed)

    running = true

    if not attachMovement(me.Character) then
        running = false
        status.Text = "Couldn't start movement"
        updateQuick()
        return
    end

    -- Automatically lock the camera onto this exact follow target.
    startCameraLock(selected)

    status.Text = "Following + camera: " .. selected.DisplayName
    updateQuick()

    loop = RunService.Heartbeat:Connect(function()
        if not running then
            return
        end

        if not selected or selected.Parent ~= Players then
            cleanup()
            selected = nil
            updateQuick()
            updateSelectionStatus()
            return
        end

        local _, hum, myRoot = getCharacterParts(me)
        local _, _, targetRootNow = getCharacterParts(selected)

        -- Wait for character parts during respawn.
        if not hum or not myRoot then
            return
        end

        if not targetRootNow then
            return
        end

        if myRoot ~= controlledRoot then
            attachMovement(me.Character)
        end

        if force and myRoot == controlledRoot then
            force.Force = Vector3.new(
                0,
                myRoot.AssemblyMass * workspace.Gravity,
                0
            )
        end

        -- Move toward the target's position, behind them.
        local goal = targetRootNow.Position
            - targetRootNow.CFrame.LookVector * FOLLOW_DISTANCE

        local delta = goal - myRoot.Position
        local step = math.min(delta.Magnitude, speed * RunService.Heartbeat:Wait() / (1/60))

        -- Use the actual frame delta for consistent movement.
        -- The Heartbeat event already fired, so cap movement by frame time.
        if delta.Magnitude > 0.05 then
            local nextPosition = myRoot.Position
                + delta.Unit * math.min(delta.Magnitude, speed / 60)

            myRoot.CFrame = CFrame.new(nextPosition)
                * myRoot.CFrame.Rotation
        end
    end)
end

-- PLAYER LIST
local function refreshPlayers()
    for _, item in ipairs(list:GetChildren()) do
        if item:IsA("TextButton") then
            item:Destroy()
        end
    end

    local others = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= me then
            table.insert(others, player)
        end
    end

    table.sort(others, function(a, b)
        return a.Name:lower() < b.Name:lower()
    end)

    for i, player in ipairs(others) do
        local isSelected = player == selected

        local button = new("TextButton", {
            Name = string.format("%03d_%s", i, player.Name),
            Size = UDim2.new(1, -4, 0, 36),
            BackgroundColor3 = isSelected
                and Color3.fromRGB(65, 45, 110)
                or CARD,
            Text = "  ◇  " .. player.Name
                .. "  (@" .. player.DisplayName .. ")",
            TextColor3 = WHITE,
            TextSize = 11,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            AutoButtonColor = true,
            ZIndex = 13
        }, list)

        corner(button, 8)
        stroke(button, isSelected and CYAN or PURPLE, 1)

        button.Activated:Connect(function()
            -- If already following, don't silently change the camera target.
            if running then
                status.Text = "Stop following before changing target"
                return
            end

            selected = player
            updateQuick()
            updateSelectionStatus()
            refreshPlayers()
        end)
    end
end

