-- UI HELPERS
local function corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 10)
    c.Parent = obj
end

local function outline(obj, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Theme.Cyan
    s.Thickness = thickness or 1.5
    s.Parent = obj
end

local function make(className, props, parent)
    local obj = Instance.new(className)
    for key, value in pairs(props) do
        obj[key] = value
    end
    obj.Parent = parent
    return obj
end

local function label(parent, value, position, size, color, fontSize)
    return make("TextLabel", {
        BackgroundTransparency = 1,
        Text = value,
        TextColor3 = color or Theme.White,
        Font = Enum.Font.GothamBold,
        TextSize = fontSize or 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Position = position,
        Size = size,
    }, parent)
end

local function button(parent, value, position, size, color)
    local b = make("TextButton", {
        Text = value,
        Position = position,
        Size = size,
        BackgroundColor3 = color or Theme.Surface,
        TextColor3 = Theme.White,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        BorderSizePixel = 0,
        AutoButtonColor = true,
    }, parent)
    corner(b, 8)
    return b
end

local function draggable(handle, target)
    local dragging = false
    local startInput
    local startPosition

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startInput = input.Position
            startPosition = target.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - startInput
            target.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)
end

local function getRoot(player)
    local character = player and player.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(player)
    local character = player and player.Character
    if not character then return nil end
    return character:FindFirstChildOfClass("Humanoid")
end

