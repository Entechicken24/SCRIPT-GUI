    task.wait(0.5)

    if followEnabled then
        stopFollow()
    end

    -- Aim Lock stays enabled and reacquires the new
    -- local character on the next render update.
end))

addConnection(Players.PlayerAdded:Connect(function()
    task.defer(refreshPlayers)
end))

addConnection(Players.PlayerRemoving:Connect(function(player)
    if player == selected then
        stopTween()
        stopFollow()
        stopAimLock()

        selected = nil
        status.Text = "Target left the game"
    end

    task.defer(refreshPlayers)
end))

-- CLEANUP
