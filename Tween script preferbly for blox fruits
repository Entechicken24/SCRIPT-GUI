-- Reliable drag handler.
-- Uses global input movement, so touch dragging works on mobile too.
local function makeDraggable(buttonObject)
    local dragging = false
    local dragInput
    local startPosition
    local startButtonPosition
    local dragMoved = false
    local suppressClick = false

    buttonObject.Active = true

    buttonObject.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.Touch
            and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
            return
        end

        dragging = true
        dragInput = input
        startPosition = input.Position
        startButtonPosition = buttonObject.Position
        dragMoved = false

        local ended
        ended = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                suppressClick = dragMoved
                if ended then ended:Disconnect() end
            end
        end)
    end)

    UIS.InputChanged:Connect(function(input)
        if not dragging then return end

        local validMouse = input.UserInputType == Enum.UserInputType.MouseMovement
        local validTouch = input.UserInputType == Enum.UserInputType.Touch
            and dragInput == input

        if not validMouse and not validTouch then return end

        local delta = input.Position - startPosition

        if math.abs(delta.X) + math.abs(delta.Y) > 5 then
            dragMoved = true
        end

        if dragMoved then
            local camera = workspace.CurrentCamera
            if not camera then return end

            local viewport = camera.ViewportSize
            local width = buttonObject.AbsoluteSize.X
            local height = buttonObject.AbsoluteSize.Y

            local x = math.clamp(
                startButtonPosition.X.Offset + delta.X,
                0,
                math.max(0, viewport.X - width)
            )

            local y = math.clamp(
                startButtonPosition.Y.Offset + delta.Y,
                -viewport.Y + height,
                -height
            )

            buttonObject.Position = UDim2.new(
                0, x,
                1, y
            )
        end
    end)

    buttonObject.Activated:Connect(function()
        if suppressClick then
            suppressClick = false
            return
        end
    end)

    return function()
        if suppressClick then
            suppressClick = false
            return true
        end
        return false
    end
end

local camWasDragged = makeDraggable(camButton)
