local function create(className, properties, parent)
    local obj = Instance.new(className)
    for key, value in pairs(properties) do
        obj[key] = value
    end
    obj.Parent = parent
    return obj
end

local function round(obj, radius)
    create("UICorner", {
        CornerRadius = UDim.new(0, radius or 10)
    }, obj)
end

local function border(obj, color, thickness)
    create("UIStroke", {
        Color = color or C.Gold,
        Thickness = thickness or 1,
        Transparency = 0.12
    }, obj)
end

local function text(parent, value, position, size, color, fontSize)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Text = value,
        TextColor3 = color or C.White,
        Font = Enum.Font.GothamMedium,
        TextSize = fontSize or 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Position = position,
        Size = size,
    }, parent)
end

local function makeButton(parent, value, position, size, background, foreground)
    local b = create("TextButton", {
        Text = value,
        Position = position,
        Size = size,
        BackgroundColor3 = background or C.Surface,
        TextColor3 = foreground or C.White,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        BorderSizePixel = 0,
        AutoButtonColor = true,
    }, parent)

    round(b, 8)
    return b
end

local function makeDraggable(handle, target)
    local dragging = false
    local dragStart
    local startPosition
    local inputConnection

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = target.Position

            if inputConnection then
                inputConnection:Disconnect()
            end

            inputConnection = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            local delta = input.Position - dragStart

            target.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)
end

local function getRoot(player)
    local character = player and player.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(player)
    local character = player and player.Character
    return character and character:FindFirstChildOfClass("Humanoid")
end

