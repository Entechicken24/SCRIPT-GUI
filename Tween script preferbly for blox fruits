    )

    zoomLabel.Text = desiredDistance .. " studs"
end)

zoomOut.Activated:Connect(function()
    desiredDistance = math.clamp(
        desiredDistance + ZOOM_STEP,
        MIN_DISTANCE,
        MAX_DISTANCE
    )

    zoomLabel.Text = desiredDistance .. " studs"
end)

UIS.InputChanged:Connect(function(input, processed)
    if processed or not aimEnabled then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseWheel then
        desiredDistance = math.clamp(
            desiredDistance - input.Position.Z * ZOOM_STEP,
            MIN_DISTANCE,
            MAX_DISTANCE
        )

        zoomLabel.Text = desiredDistance .. " studs"
    end
end)

-- RESPAWN SUPPORT
