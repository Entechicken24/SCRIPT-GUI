-- SMOOTH LOOP TWEEN
-- Speed is distance / duration, measured in studs per second.
--============================================================

local loopButton = makeButton(gui, "START LOOP TWEEN",
    UDim2.fromOffset(22, 150), UDim2.fromOffset(190, 40),
    C.Gold, C.Background)
border(loopButton, C.DeepGold, 1)
