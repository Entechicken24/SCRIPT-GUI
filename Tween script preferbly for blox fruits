	card.Size = UDim2.new(1, -4, 0, 48)
	card.BackgroundColor3 = Color3.fromRGB(31, 31, 36)
	card.Text = ""
	card.AutoButtonColor = true
	card.Parent = playerScroll
	addCorner(card, 8)
	addStroke(card, Color3.fromRGB(105, 83, 43), 1)

