Players.PlayerRemoving:Connect(function(plr)
	if selectedPlayer == plr then
		selectedPlayer = nil
		selectedLabel.Text = "Target: None"
		status.Text = "TARGET LEFT THE SERVER"
		if cameraLocked then
			stopCameraLock()
		end
		if moving then
			stopMoving()
		end
	end
	refreshPlayerList()
end)

player.CharacterAdded:Connect(function()
	if cameraLocked then
		stopCameraLock()
	end
	if moving then
		stopMoving()
	end
end)

