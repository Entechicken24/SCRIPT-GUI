-- Movement controller
local function stopMovement()
    moving = false
    if moveVelocity then moveVelocity:Destroy() moveVelocity = nil end
    if moveAttachment then moveAttachment:Destroy() moveAttachment = nil end
    moveRoot = nil
    moveButton.Text = "START MOVE"
    status.Text = "Movement stopped"
end

local function startMovement()
    if not selectedPlayer then
        status.Text = "Select a player first"
        return
    end

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local targetCharacter = selectedPlayer.Character
    local targetRoot = targetCharacter
        and targetCharacter:FindFirstChild("HumanoidRootPart")

    if not humanoid or humanoid.Health <= 0 or not root or not targetRoot then
        status.Text = "Character or target unavailable"
        return
    end

    stopMovement()

    moveRoot = root
    moveAttachment = Instance.new("Attachment")
    moveAttachment.Parent = root

    moveVelocity = Instance.new("LinearVelocity")
    moveVelocity.Attachment0 = moveAttachment
    moveVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    moveVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    moveVelocity.ForceLimitsEnabled = false
    moveVelocity.VectorVelocity = Vector3.zero
    moveVelocity.Parent = root

    moving = true
    moveButton.Text = "STOP MOVE"
    status.Text = "Moving toward " .. selectedPlayer.DisplayName
end

moveButton.Activated:Connect(function()
    -- Ignore the click that ends a drag.
    if getMoveDragged() then return end
    if moving then stopMovement() else startMovement() end
end)

-- Camera lock
local function getAimPart(p)
    local character = p and p.Character
    return character and (
        character:FindFirstChild("Head")
        or character:FindFirstChild("HumanoidRootPart")
    )
end

local function unlockCamera()
    if not cameraLocked then return end
    cameraLocked = false
    activeTouch = nil
    camButton.Text = "CAM LOCK: OFF"

    local camera = workspace.CurrentCamera
    if camera then
        camera.CameraType = savedCameraType or Enum.CameraType.Custom
        camera.CameraSubject = savedCameraSubject

        if not camera.CameraSubject then
            local character = player.Character
            camera.CameraSubject = character
                and character:FindFirstChildOfClass("Humanoid")
        end
    end

    status.Text = "Camera lock off"
end

local function lockCamera()
    if not selectedPlayer then
        status.Text = "Select a player first"
        return
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local aimPart = getAimPart(selectedPlayer)
    local camera = workspace.CurrentCamera

    if not root or not aimPart or not camera then
        status.Text = "Target or character unavailable"
        return
    end

    savedCameraType = camera.CameraType
    savedCameraSubject = camera.CameraSubject

    local look = camera.CFrame.LookVector
    cameraYaw = math.atan2(-look.X, -look.Z)
    cameraPitch = math.clamp(
        math.asin(look.Y), math.rad(-35), math.rad(35)
    )

    camera.CameraType = Enum.CameraType.Scriptable
    cameraLocked = true
    camButton.Text = "CAM LOCK: ON"
    status.Text = "Locked onto " .. selectedPlayer.DisplayName
end

camButton.Activated:Connect(function()
    -- Ignore the click that ends a drag.
    if getCamDragged() then return end
    if cameraLocked then unlockCamera() else lockCamera() end
end)

-- Rotate the camera by dragging on the right half of the screen.
local function touchOnGui(pos)
    local ok, objects = pcall(function()
        return playerGui:GetGuiObjectsAtPosition(pos.X, pos.Y)
    end)
    if not ok then return false end

    for _, obj in ipairs(objects) do
        if obj:IsDescendantOf(gui) then return true end
    end
    return false
end

UIS.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        local camera = workspace.CurrentCamera
        if cameraLocked and camera
            and input.Position.X >= camera.ViewportSize.X * 0.48
            and not touchOnGui(input.Position) then
            activeTouch = input
        end
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        rightMouseHeld = true
    end
end)

UIS.InputChanged:Connect(function(input)
    if not cameraLocked then return end

    if input.UserInputType == Enum.UserInputType.Touch
        and activeTouch and input == activeTouch then
        cameraYaw = cameraYaw - input.Delta.X * 0.008
        cameraPitch = math.clamp(
            cameraPitch - input.Delta.Y * 0.006,
            math.rad(-35), math.rad(35)
        )
    elseif input.UserInputType == Enum.UserInputType.MouseMovement
        and rightMouseHeld then
        cameraYaw = cameraYaw - input.Delta.X * 0.004
        cameraPitch = math.clamp(
            cameraPitch - input.Delta.Y * 0.004,
            math.rad(-35), math.rad(35)
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input == activeTouch then activeTouch = nil end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        rightMouseHeld = false
    end
end)

RunService:BindToRenderStep(
    "NeonCyberControlCenterUpdate",
    Enum.RenderPriority.Camera.Value + 1,
    function()
        if moving then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local targetCharacter = selectedPlayer and selectedPlayer.Character
            local targetHumanoid = targetCharacter
                and targetCharacter:FindFirstChildOfClass("Humanoid")
            local targetRoot = targetCharacter
                and targetCharacter:FindFirstChild("HumanoidRootPart")

            if not humanoid or humanoid.Health <= 0 or root ~= moveRoot
                or not targetHumanoid or targetHumanoid.Health <= 0
                or not targetRoot or not moveVelocity then
                stopMovement()
            else
                local delta = targetRoot.Position - root.Position
                moveVelocity.VectorVelocity = delta.Magnitude <= 5
                    and Vector3.zero or delta.Unit * speed
            end
        end

        if cameraLocked then
            local camera = workspace.CurrentCamera
            local character = player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local aimPart = getAimPart(selectedPlayer)

            if not camera or not root or not aimPart then
                unlockCamera()
                return
            end

            local rotation = CFrame.fromOrientation(cameraPitch, cameraYaw, 0)
            local offset = rotation:VectorToWorldSpace(
                Vector3.new(0, cameraHeight, cameraDistance)
            )
            local cameraPosition = root.Position + offset
            local aimPosition = aimPart.Position + Vector3.new(0, 0.4, 0)
            local desired = CFrame.lookAt(cameraPosition, aimPosition)

            camera.CFrame = camera.CFrame:Lerp(desired, 0.25)
        end
    end
)

player.CharacterAdded:Connect(function()
    stopMovement()
    if cameraLocked then unlockCamera() end
end)

updateSpeed()
status.Text = "Ready • Select a player"
