local function updateCards()
    for p, card in pairs(cards) do
        if card.Parent then
            card.BackgroundColor3 = p == selectedPlayer
                and Color3.fromRGB(73, 55, 26)
                or Color3.fromRGB(34, 34, 39)
        end
    end
end

local function addPlayer(p)
    if p == player or cards[p] then return end

    local card = Instance.new("TextButton")
    card.Size = UDim2.new(1, -3, 0, 44)
    card.BackgroundColor3 = Color3.fromRGB(34, 34, 39)
    card.Text = ""
    card.Parent = playerScroll
    round(card)
    outline(card)

    local avatar = Instance.new("ImageLabel")
    avatar.Size = UDim2.fromOffset(32, 32)
    avatar.Position = UDim2.fromOffset(6, 6)
    avatar.BackgroundColor3 = DARK
    avatar.Parent = card
    round(avatar, 7)

    local name = makeLabel(
        card, p.DisplayName .. "\n@" .. p.Name,
        UDim2.new(1, -48, 1, 0), UDim2.fromOffset(44, 0), 12
    )
    name.TextXAlignment = Enum.TextXAlignment.Left

    cards[p] = card

    task.spawn(function()
        local ok, image = pcall(function()
            return Players:GetUserThumbnailAsync(
                p.UserId,
                Enum.ThumbnailType.HeadShot,
                Enum.ThumbnailSize.Size100x100
            )
        end)
        if ok and avatar.Parent then avatar.Image = image end
    end)

    card.Activated:Connect(function()
        selectedPlayer = p
        updateCards()
        status.Text = "Selected: " .. p.DisplayName
    end)
end

local function removePlayer(p)
    if cards[p] then
        cards[p]:Destroy()
        cards[p] = nil
    end
    if selectedPlayer == p then
        selectedPlayer = nil
        updateCards()
    end
end

