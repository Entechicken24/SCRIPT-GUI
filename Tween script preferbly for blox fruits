--====================================================
-- MOVEMENT
--====================================================

local function stopMovement()
    moving = false

    if moveVelocity then
        moveVelocity:Destroy()
        moveVelocity = nil
    end

    if moveAttachment then
        moveAttachment:Destroy()
        moveAttachment = nil
    end

    moveRoot = nil
    moveButton.Text = "START MOVE"
    setStatus("Movement stopped")
end

local function startMovement()
    if not selectedPlayer then
        setStatus("Select a player first")
        return
    end

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local targetCharacter = selectedPlayer.Character
    local targetRoot = targetCharacter
        and targetCharacter:FindFirstChild("HumanoidRootPart")

    if not humanoid or humanoid.Health <= 0 or not root or not targetRoot then
        setStatus("Character or target unavailable")
        return
    end

    stopMovement()

    moveRoot = root

    moveAttachment = Instance.new("Attachment")
    moveAttachment.Name = "NeonMovementAttachment"
    moveAttachment.Parent = root

    moveVelocity = Instance.new("LinearVelocity")
    moveVelocity.Name = "NeonMovementVelocity"
    moveVelocity.Attachment0 = moveAttachment
    moveVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    moveVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    moveVelocity.VectorVelocity = Vector3.zero
    moveVelocity.ForceLimitsEnabled = false
    moveVelocity.Parent = root

    moving = true
    moveButton.Text = "STOP MOVE"
    setStatus("Moving toward " .. selectedPlayer.DisplayName)
end

moveButton.Activated:Connect(function()
    if moving then
        stopMovement()
    else
        startMovement()
    end
end)

--====================================================
-- CAMERA LOCK
--====================================================

local function getAimPart(p)
    local character = p and p.Character
    if not character then
        return nil
    end

    return character:FindFirstChild("Head")
        or character:FindFirstChild("HumanoidRootPart")
end

local function unlockCamera()
    if not cameraLocked then
        return
    end

    cameraLocked = false
    activeTouch = nil
    camButton.Text = "CAM LOCK: OFF"

    local camera = workspace.CurrentCamera
    if camera then
        camera.CameraType = previousCameraType or Enum.CameraType.Custom
        camera.CameraSubject = previousCameraSubject

        if not previousCameraSubject then
            local character = player.Character
            local humanoid = character
                and character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                camera.CameraSubject = humanoid
            end
        end
    end

    setStatus("Camera lock off")
end

local function lockCamera()
    if not selectedPlayer then
        setStatus("Select a player first")
        return
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local targetPart = getAimPart(selectedPlayer)

    if not root or not targetPart then
        setStatus("Target or character unavailable")
        return
    end

    local camera = workspace.CurrentCamera
    if not camera then
        setStatus("Camera unavailable")
        return
    end

    previousCameraType = camera.CameraType
    previousCameraSubject = camera.CameraSubject

    local look = camera.CFrame.LookVector
    cameraYaw = math.atan2(-look.X, -look.Z)
    cameraPitch = math.clamp(
        math.asin(look.Y),
        math.rad(-35),
        math.rad(35)
    )

    camera.CameraType = Enum.CameraType.Scriptable
    cameraLocked = true
    camButton.Text = "CAM LOCK: ON"
    setStatus("Locked onto " .. selectedPlayer.DisplayName)
end

camButton.Activated:Connect(function()
    if cameraLocked then
        unlockCamera()
    else
        lockCamera()
    end
end)

local function touchIsOnOurGui(position)
    local ok, objects = pcall(function()
        return playerGui:GetGuiObjectsAtPosition(position.X, position.Y)
    end)

    if not ok then
        return false
    end

    for _, object in ipairs(objects) do
        if object:IsDescendantOf(screen) then
            return true
        end
    end

    return false
end

UserInputService.InputBegan:Connect(function(input, processed)
    if input.UserInputType == Enum.UserInputType.Touch then
        local camera = workspace.CurrentCamera
        if not camera or not cameraLocked then
            return
        end

        if input.Position.X >= camera.ViewportSize.X * 0.48
            and not touchIsOnOurGui(input.Position) then
            activeTouch = input
        end

    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        rightMouseHeld = true
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not cameraLocked then
        return
    end

    if input.UserInputType == Enum.UserInputType.Touch
        and activeTouch
        and input == activeTouch then

        cameraYaw = cameraYaw - input.Delta.X * 0.008
        cameraPitch = math.clamp(
            cameraPitch - input.Delta.Y * 0.006,
            math.rad(-35),
            math.rad(35)
        )

    elseif input.UserInputType == Enum.UserInputType.MouseMovement
        and rightMouseHeld then

        cameraYaw = cameraYaw - input.Delta.X * 0.004
        cameraPitch = math.clamp(
            cameraPitch - input.Delta.Y * 0.004,
            math.rad(-35),
            math.rad(35)
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == activeTouch then
        activeTouch = nil
    end

    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        rightMouseHeld = false
    end
end)

--====================================================
-- UPDATE LOOP
--====================================================

RunService:BindToRenderStep(
    "NeonCyberControlCenterCamera",
    Enum.RenderPriority.Camera.Value + 1,
    function()
        local camera = workspace.CurrentCamera

        -- Movement toward selected target.
        if moving then
            local character = player.Character
            local humanoid = character
                and character:FindFirstChildOfClass("Humanoid")
            local root = character
                and character:FindFirstChild("HumanoidRootPart")

            local targetCharacter = selectedPlayer
                and selectedPlayer.Character
            local targetHumanoid = targetCharacter
                and targetCharacter:FindFirstChildOfClass("Humanoid")
            local targetRoot = targetCharacter
                and targetCharacter:FindFirstChild("HumanoidRootPart")

            if not humanoid or humanoid.Health <= 0
                or not root or root ~= moveRoot
                or not targetHumanoid or targetHumanoid.Health <= 0
                or not targetRoot or not moveVelocity then

                stopMovement()
            else
                local difference = targetRoot.Position - root.Position

                if difference.Magnitude <= 5 then
                    moveVelocity.VectorVelocity = Vector3.zero
                else
                    moveVelocity.VectorVelocity = difference.Unit * speed
                end
            end
        end

        -- Camera tracks the selected target while lock is active.
        if cameraLocked and camera then
            local character = player.Character
            local root = character
                and character:FindFirstChild("HumanoidRootPart")
            local aimPart = getAimPart(selectedPlayer)

            if not root or not aimPart then
                unlockCamera()
                return
            end

            local rotation = CFrame.fromOrientation(
                cameraPitch,
                cameraYaw,
                0
            )

            local offset = rotation:VectorToWorldSpace(
                Vector3.new(0, cameraHeight, cameraDistance)
            )

            local cameraPosition = root.Position + offset
            local targetPosition = aimPart.Position + Vector3.new(0, 0.4, 0)

            local desired = CFrame.lookAt(cameraPosition, targetPosition)
            camera.CFrame = camera.CFrame:Lerp(desired, 0.25)
        end
    end
)

