--==================================================
-- MOVEMENT START / STOP
--==================================================

local function stopMovement()
	moving = false

	if movementVelocity then
		movementVelocity:Destroy()
		movementVelocity = nil
	end

	if movementAttachment then
		movementAttachment:Destroy()
		movementAttachment = nil
	end

	movementRoot = nil
	moveButton.Text = "START MOVE"
	setStatus("Movement stopped")
end

local function startMovement()
	if not selectedPlayer then
		setStatus("Select a target first")
		return
	end

	local _, _, targetRoot = getCharacterParts(selectedPlayer)
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if not targetRoot or not root or not humanoid or humanoid.Health <= 0 then
		setStatus("Target or character unavailable")
		return
	end

	stopMovement()

	movementRoot = root
	movementAttachment = Instance.new("Attachment")
	movementAttachment.Name = "NeonMoveAttachment"
	movementAttachment.Parent = root

	movementVelocity = Instance.new("LinearVelocity")
	movementVelocity.Name = "NeonMoveVelocity"
	movementVelocity.Attachment0 = movementAttachment
	movementVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
	movementVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	movementVelocity.VectorVelocity = Vector3.zero
	movementVelocity.ForceLimitsEnabled = false
	movementVelocity.Parent = root

	moving = true
	moveButton.Text = "STOP MOVE"
	setStatus("Moving toward " .. selectedPlayer.DisplayName)
end

moveButton.Activated:Connect(function()
	if moving then
		stopMovement()
	else
		startMovement()
	end
end)

--==================================================
-- REAL CAMERA LOCK
-- Aims the camera at the selected player's head.
-- Right-side touch drag rotates the camera on mobile.
-- Right mouse drag rotates the camera on desktop.
--==================================================

local function isTouchOverGui(position)
	local ok, objects = pcall(function()
		return GuiService:GetGuiObjectsAtPosition(position.X, position.Y)
	end)

	if not ok then
		return false
	end

	for _, object in ipairs(objects) do
		if object:IsDescendantOf(gui) then
			return true
		end
	end

	return false
end

local function unlockCamera()
	cameraLocked = false
	camButton.Text = "CAM LOCK: OFF"

	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = savedCameraType or Enum.CameraType.Custom
		camera.CameraSubject = savedCameraSubject
	end

	if savedMouseBehavior then
		UserInputService.MouseBehavior = savedMouseBehavior
	end

	setStatus("Camera lock off")
end

local function lockCamera()
	if not selectedPlayer then
		setStatus("Select a target first")
		return
	end

	local aimPart = getAimPart(selectedPlayer)
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if not aimPart or not root then
		setStatus("Target or character unavailable")
		return
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	savedCameraType = camera.CameraType
	savedCameraSubject = camera.CameraSubject
	savedMouseBehavior = UserInputService.MouseBehavior

	local lookVector = camera.CFrame.LookVector
	yaw = math.atan2(-lookVector.X, -lookVector.Z)
	pitch = math.clamp(math.asin(lookVector.Y), math.rad(-45), math.rad(25))

	camera.CameraType = Enum.CameraType.Scriptable
	cameraLocked = true
	camButton.Text = "CAM LOCK: ON"
	setStatus("Camera locked onto " .. selectedPlayer.DisplayName)
end

camButton.Activated:Connect(function()
	if cameraLocked then
		unlockCamera()
	else
		lockCamera()
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end

	if input.UserInputType == Enum.UserInputType.Touch then
		local position = input.Position
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end

		-- Reserve the left side for the movement joystick.
		-- Ignore touches that begin on this GUI.
		if cameraLocked
			and position.X >= camera.ViewportSize.X * 0.48
			and not isTouchOverGui(position) then
			activeTouch = input
		end

	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		rightMouseHeld = true
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not cameraLocked then
		return
	end

	if input.UserInputType == Enum.UserInputType.Touch
		and activeTouch
		and input == activeTouch then

		yaw = yaw - input.Delta.X * 0.008
		pitch = math.clamp(
			pitch - input.Delta.Y * 0.006,
			math.rad(-35),
			math.rad(35)
		)

	elseif input.UserInputType == Enum.UserInputType.MouseMovement
		and rightMouseHeld then

		yaw = yaw - input.Delta.X * 0.004
		pitch = math.clamp(
			pitch - input.Delta.Y * 0.004,
			math.rad(-35),
			math.rad(35)
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input == activeTouch then
		activeTouch = nil
	end

	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		rightMouseHeld = false
	end
end)

--==================================================
-- MAIN UPDATE LOOP
--==================================================

RunService.RenderStepped:Connect(function()
	local camera = workspace.CurrentCamera

	-- Movement follows the currently selected target.
	if moving then
		local _, targetHumanoid, targetRoot = getCharacterParts(selectedPlayer)
		local character = LocalPlayer.Character
		local ownHumanoid = character and character:FindFirstChildOfClass("Humanoid")
		local ownRoot = character and character:FindFirstChild("HumanoidRootPart")

		if not selectedPlayer
			or not targetRoot
			or not targetHumanoid
			or targetHumanoid.Health <= 0
			or not ownRoot
			or not ownHumanoid
			or ownHumanoid.Health <= 0
			or not movementVelocity
			or movementRoot ~= ownRoot then

			stopMovement()
		else
			local difference = targetRoot.Position - ownRoot.Position
			local distance = difference.Magnitude

			if distance <= 5 then
				movementVelocity.VectorVelocity = Vector3.zero
				moveButton.Text = "STOP MOVE"
				setStatus("Near target")
			else
				movementVelocity.VectorVelocity =
					difference.Unit * MOVE_SPEED
			end
		end
	end

	-- Camera lock aims toward the selected target every frame.
	-- Camera CFrame is only controlled while lock is enabled.
	if cameraLocked and camera then
		local character = LocalPlayer.Character
		local ownRoot = character and character:FindFirstChild("HumanoidRootPart")
		local aimPart = getAimPart(selectedPlayer)

		if not ownRoot or not aimPart then
			unlockCamera()
			return
		end

		local rotation = CFrame.fromOrientation(pitch, yaw, 0)
		local offset = rotation:VectorToWorldSpace(
			Vector3.new(0, CAMERA_HEIGHT, CAMERA_DISTANCE)
		)

		local cameraPosition = ownRoot.Position + offset
		local aimPosition = aimPart.Position + Vector3.new(0, 0.4, 0)

		local desiredCFrame = CFrame.lookAt(cameraPosition, aimPosition)

		-- Smoothly follow without freezing the view.
		camera.CFrame = camera.CFrame:Lerp(desiredCFrame, 0.22)
	end
end)

-- Stop movement if the local character respawns.
LocalPlayer.CharacterAdded:Connect(function()
	stopMovement()

	if cameraLocked then
		task.defer(function()
			unlockCamera()
		end)
	end
end)

-- If the selected target leaves, stop safely.
Players.PlayerRemoving:Connect(function(player)
	if player == selectedPlayer then
		stopMovement()
		if cameraLocked then
			unlockCamera()
		end
	end
end)

