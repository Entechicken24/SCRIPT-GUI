--// NOCLIP
local function setNoclip(enabled)
    noclipEnabled = enabled

    noclipButton.Text = enabled and "◇  NOCLIP: ON" or "◇  NOCLIP: OFF"
    noclipButton.TextColor3 = enabled and GREEN or BLUE

    statusText.Text = enabled and "NOCLIP ENABLED" or "NOCLIP DISABLED"
    statusText.TextColor3 = enabled and GREEN or CYAN
end

local function applyNoclip()
    local character = LocalPlayer.Character

    if not character then
        return
    end

    if noclipEnabled then
        for _, item in ipairs(character:GetDescendants()) do
            if item:IsA("BasePart") then
                if originalCollision[item] == nil then
                    originalCollision[item] = item.CanCollide
                end

                item.CanCollide = false
            end
        end
    else
        for part, originalValue in pairs(originalCollision) do
            if part and part.Parent then
                part.CanCollide = originalValue
            end
        end

        table.clear(originalCollision)
    end
end

noclipButton.Activated:Connect(function()
    setNoclip(not noclipEnabled)
    applyNoclip()
end)

