    if selectedPlayer == player then
        selectedPlayer = nil
        selectedLabel.Text = "TARGET: NONE"
        selectedLabel.TextColor3 = Theme.Purple
        loopEnabled = false
        loopToken += 1
    end
    refreshPlayers()
end)

