local function addPlayer(p)
    if p == player or cards[p] then return end

    local card = Instance.new("TextButton")
    card.Size = UDim2.new(1, -3, 0, 43)
    card.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    card.Text = ""
    card.Parent = playerList
    corner(card)
    outline(card)

    local avatar = Instance.new("ImageLabel")
    avatar.Position = UDim2.fromOffset(5, 5)
    avatar.Size = UDim2.fromOffset(33, 33)
    avatar.BackgroundColor3 = DARK
    avatar.Parent = card
    corner(avatar, 7)

    local name = makeLabel(
        card, p.DisplayName .. "  @" .. p.Name,
        UDim2.new(1, -46, 1, 0), UDim2.fromOffset(43, 0), 11
    )
    name.TextXAlignment = Enum.TextXAlignment.Left

    cards[p] = card

    task.spawn(function()
        local ok, image = pcall(function()
            return Players:GetUserThumbnailAsync(
                p.UserId,
                Enum.ThumbnailType.HeadShot,
                Enum.ThumbnailSize.Size100x100
            )
        end)
        if ok and avatar.Parent then avatar.Image = image end
    end)

    card.Activated:Connect(function()
        selectedPlayer = p
        refreshCards()
        status.Text = "Selected: " .. p.DisplayName
    end)
end

local function removePlayer(p)
    if cards[p] then cards[p]:Destroy() end
    cards[p] = nil
    if selectedPlayer == p then
        selectedPlayer = nil
        refreshCards()
    end
end

