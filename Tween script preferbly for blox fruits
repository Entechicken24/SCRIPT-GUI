local function stopCameraTracking()
    aimEnabled = false

    if aimConnection then
        aimConnection:Disconnect()
        aimConnection = nil
    end

    local camera = workspace.CurrentCamera
    if camera then
        camera.CameraType = savedCameraType or Enum.CameraType.Custom

        if savedCameraSubject and savedCameraSubject.Parent then
            camera.CameraSubject = savedCameraSubject
        end
    end

    aimButton.Text = "CAMERA TRACK  /  OFF"
    aimButton.TextColor3 = C.Gold
end

aimButton.Activated:Connect(function()
    if aimEnabled then
        stopCameraTracking()
        return
    end

    if not selectedPlayer then
        status.Text = "●  SELECT A TARGET FIRST"
        status.TextColor3 = C.Red
        return
    end

    local camera = workspace.CurrentCamera
    if not camera then return end

    savedCameraType = camera.CameraType
    savedCameraSubject = camera.CameraSubject
    camera.CameraType = Enum.CameraType.Scriptable

    aimEnabled = true
    aimButton.Text = "CAMERA TRACK  /  ON"
    aimButton.TextColor3 = C.BrightGold

    aimConnection = RunService.RenderStepped:Connect(function()
        local targetRoot = getRoot(selectedPlayer)

        if not targetRoot then
            stopCameraTracking()
            return
        end

        local currentCamera = workspace.CurrentCamera
        if currentCamera then
            currentCamera.CFrame = CFrame.lookAt(
                currentCamera.CFrame.Position,
                targetRoot.Position
            )
        end
    end)
end)

