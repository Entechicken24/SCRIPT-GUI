-- Movement controls.
local function stopMovement()
    moving = false
    if moveVelocity then moveVelocity:Destroy() moveVelocity = nil end
    if moveAttachment then moveAttachment:Destroy() moveAttachment = nil end
    moveRoot = nil
    moveButton.Text = "START MOVE"
end

local function startMovement()
    if not selectedPlayer then
        status.Text = "Select a player first"
        return
    end

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local target = selectedPlayer.Character
    local targetRoot = target and target:FindFirstChild("HumanoidRootPart")

    if not humanoid or humanoid.Health <= 0 or not root or not targetRoot then
        status.Text = "Character unavailable"
        return
    end

    stopMovement()
    moveRoot = root

    moveAttachment = Instance.new("Attachment")
    moveAttachment.Parent = root

    moveVelocity = Instance.new("LinearVelocity")
    moveVelocity.Attachment0 = moveAttachment
    moveVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    moveVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    moveVelocity.ForceLimitsEnabled = false
    moveVelocity.VectorVelocity = Vector3.zero
    moveVelocity.Parent = root

    moving = true
    moveButton.Text = "STOP MOVE"
    status.Text = "Movement active"
end

moveButton.Activated:Connect(function()
    if moveWasDragged() then return end
    if moving then stopMovement() else startMovement() end
end)

-- Camera lock.
local function aimPart(p)
    local character = p and p.Character
    return character and (
        character:FindFirstChild("Head")
        or character:FindFirstChild("HumanoidRootPart")
    )
end

local function unlockCamera()
    if not cameraLocked then return end
    cameraLocked = false
    touchDrag = nil
    camButton.Text = "CAM LOCK: OFF"

    local camera = workspace.CurrentCamera
    if camera then
        camera.CameraType = savedCameraType or Enum.CameraType.Custom
        camera.CameraSubject = savedCameraSubject
        if not camera.CameraSubject then
            local character = player.Character
            camera.CameraSubject = character
                and character:FindFirstChildOfClass("Humanoid")
        end
    end
    status.Text = "Camera unlocked"
end

local function lockCamera()
    if not selectedPlayer then
        status.Text = "Select a player first"
        return
    end

    local camera = workspace.CurrentCamera
    local part = aimPart(selectedPlayer)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not camera or not part or not root then
        status.Text = "Target or character unavailable"
        return
    end

    savedCameraType = camera.CameraType
    savedCameraSubject = camera.CameraSubject

    local look = camera.CFrame.LookVector
    yaw = math.atan2(-look.X, -look.Z)
    pitch = math.clamp(math.asin(look.Y), math.rad(-35), math.rad(35))

    camera.CameraType = Enum.CameraType.Scriptable
    cameraLocked = true
    camButton.Text = "CAM LOCK: ON"
    status.Text = "Camera locked"
end

camButton.Activated:Connect(function()
    if camWasDragged() then return end
    if cameraLocked then unlockCamera() else lockCamera() end
end)

-- Right-side touch camera control and desktop right-mouse drag.
UIS.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        local camera = workspace.CurrentCamera
        if cameraLocked and camera
            and input.Position.X > camera.ViewportSize.X * 0.48 then
            touchDrag = input
        end
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        mouseDrag = true
    end
end)

UIS.InputChanged:Connect(function(input)
    if not cameraLocked then return end

    if input.UserInputType == Enum.UserInputType.Touch
        and touchDrag and input == touchDrag then
        yaw = yaw - input.Delta.X * 0.008
        pitch = math.clamp(
            pitch - input.Delta.Y * 0.006,
            math.rad(-35), math.rad(35)
        )
    elseif input.UserInputType == Enum.UserInputType.MouseMovement and mouseDrag then
        yaw = yaw - input.Delta.X * 0.004
        pitch = math.clamp(
            pitch - input.Delta.Y * 0.004,
            math.rad(-35), math.rad(35)
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input == touchDrag then touchDrag = nil end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        mouseDrag = false
    end
end)

RunService:BindToRenderStep(
    "NeonCyberCamera",
    Enum.RenderPriority.Camera.Value + 1,
    function()
        if moving then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local target = selectedPlayer and selectedPlayer.Character
            local targetHumanoid = target and target:FindFirstChildOfClass("Humanoid")
            local targetRoot = target and target:FindFirstChild("HumanoidRootPart")

            if not humanoid or humanoid.Health <= 0 or root ~= moveRoot
                or not targetHumanoid or targetHumanoid.Health <= 0
                or not targetRoot or not moveVelocity then
                stopMovement()
            else
                local delta = targetRoot.Position - root.Position
                moveVelocity.VectorVelocity = delta.Magnitude <= 5
                    and Vector3.zero or delta.Unit * speed
            end
        end

        if cameraLocked then
            local camera = workspace.CurrentCamera
            local character = player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local part = aimPart(selectedPlayer)

            if not camera or not root or not part then
                unlockCamera()
                return
            end

            local rotation = CFrame.fromOrientation(pitch, yaw, 0)
            local offset = rotation:VectorToWorldSpace(Vector3.new(0, 4, 12))
            local cameraPosition = root.Position + offset
            local targetPosition = part.Position + Vector3.new(0, 0.4, 0)

            camera.CFrame = camera.CFrame:Lerp(
                CFrame.lookAt(cameraPosition, targetPosition),
                0.25
            )
        end
    end
)

player.CharacterAdded:Connect(function()
    stopMovement()
    if cameraLocked then unlockCamera() end
end)

Players.PlayerRemoving:Connect(function(p)
    if p == selectedPlayer then
        stopMovement()
        if cameraLocked then unlockCamera() end
        selectedPlayer = nil
    end
end)

updateSpeed()
status.Text = "Ready — select a player"
