local function refreshPlayerList()
	for _, child in ipairs(playerList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local row = Instance.new("TextButton")
			row.Name = "Player_" .. plr.UserId
			row.Size = UDim2.new(1, -4, 0, 48)
			row.BackgroundColor3 = DARK
			row.BorderSizePixel = 0
			row.Text = ""
			row.Parent = playerList
			round(row, 7)

			local avatar = Instance.new("ImageLabel")
			avatar.Position = UDim2.new(0, 5, 0, 4)
			avatar.Size = UDim2.fromOffset(40, 40)
			avatar.BackgroundColor3 = PANEL
			avatar.BorderSizePixel = 0
			avatar.Image = ""
			avatar.Parent = row
			round(avatar, 20)

			task.spawn(function()
				local success, image = pcall(function()
					return Players:GetUserThumbnailAsync(
						plr.UserId,
						Enum.ThumbnailType.HeadShot,
						Enum.ThumbnailSize.Size100x100
					)
				end)
				if success and avatar.Parent then
					avatar.Image = image
				end
			end)

			local nameLabel = Instance.new("TextLabel")
			nameLabel.Position = UDim2.new(0, 53, 0, 0)
			nameLabel.Size = UDim2.new(1, -58, 1, 0)
			nameLabel.BackgroundTransparency = 1
			nameLabel.Text = plr.DisplayName .. "  (@" .. plr.Name .. ")"
			nameLabel.TextColor3 = WHITE
			nameLabel.TextSize = 12
			nameLabel.Font = Enum.Font.GothamMedium
			nameLabel.TextXAlignment = Enum.TextXAlignment.Left
			nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
			nameLabel.Parent = row

			local function chooseTarget()
				selectedPlayer = plr
				selectedLabel.Text = "Target: " .. plr.DisplayName
				status.Text = "TARGET SELECTED"
				for _, other in ipairs(playerList:GetChildren()) do
					if other:IsA("TextButton") then
						other.BackgroundColor3 =
							other == row and Color3.fromRGB(60, 48, 24) or DARK
					end
				end
			end

			row.Activated:Connect(chooseTarget)
		end
	end
end

