			avatar.Position = UDim2.fromOffset(4, 3)
			avatar.Size = UDim2.fromOffset(38, 38)
			avatar.BackgroundTransparency = 1
			avatar.Parent = row
			round(avatar, 20)

			task.spawn(function()
				local ok, image = pcall(function()
					return Players:GetUserThumbnailAsync(
						plr.UserId,
