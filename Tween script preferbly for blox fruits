-- =========================================================
-- TOUCH + MOUSE DRAGGING
-- Uses TouchMoved rather than relying on TouchId matching.
-- Each draggable button handles its own drag.
-- =========================================================

local function clampPosition(button, x, y)
    local camera = workspace.CurrentCamera
    if not camera then
        return x, y
    end

    local viewport = camera.ViewportSize
    local size = button.AbsoluteSize

    x = math.clamp(x, 0, math.max(0, viewport.X - size.X))
    y = math.clamp(y, 0, math.max(0, viewport.Y - size.Y))

    return x, y
end

local function finishDrag()
    if not dragState then
        return
    end

    local state = dragState
    dragState = nil

    if state.moved then
        suppressActivation[state.button] = true
        task.delay(0.25, function()
            suppressActivation[state.button] = nil
        end)
    end
end

local function makeDraggable(button)
    button.Active = true
    button.Selectable = false

    button.InputBegan:Connect(function(input)
        if destroyed or dragState then
            return
        end

        local isTouch = input.UserInputType == Enum.UserInputType.Touch
        local isMouse = input.UserInputType == Enum.UserInputType.MouseButton1

        if not isTouch and not isMouse then
            return
        end

        dragState = {
            button = button,
            input = input,
            isTouch = isTouch,
            startX = input.Position.X,
            startY = input.Position.Y,
            startPosition = button.Position,
            moved = false,
        }

        if isTouch then
            -- The original touch InputObject's Position can be stale
            -- on some devices, so TouchMoved updates the active drag.
            dragState.lastX = input.Position.X
            dragState.lastY = input.Position.Y
        end
    end)

    button.InputEnded:Connect(function(input)
        if dragState and dragState.button == button then
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                finishDrag()
            end
        end
    end)
end

makeDraggable(reopenButton)
makeDraggable(cameraButton)
makeDraggable(followButton)

UIS.TouchMoved:Connect(function(input)
    local state = dragState
    if not state or not state.isTouch then
        return
    end

    -- Only one active drag is allowed. On touch devices, use the
    -- currently moving touch without relying on TouchId equality.
    local x = input.Position.X
    local y = input.Position.Y

    local deltaX = x - state.lastX
    local deltaY = y - state.lastY

    if math.abs(x - state.startX) > 5 or math.abs(y - state.startY) > 5 then
        state.moved = true
    end

    if state.moved then
        local button = state.button
        local newX = button.Position.X.Offset + deltaX
        local newY = button.Position.Y.Offset + deltaY
        newX, newY = clampPosition(button, newX, newY)

        button.Position = UDim2.new(0, newX, 0, newY)
    end

    state.lastX = x
    state.lastY = y
end)

UIS.InputChanged:Connect(function(input)
    local state = dragState
    if not state or state.isTouch then
        return
    end

    if input.UserInputType ~= Enum.UserInputType.MouseMovement then
        return
    end

    local x = input.Position.X
    local y = input.Position.Y

    local deltaX = x - state.startX
    local deltaY = y - state.startY

    if math.abs(deltaX) > 5 or math.abs(deltaY) > 5 then
        state.moved = true
    end

    if state.moved then
        local button = state.button
        local newX = state.startPosition.X.Offset + deltaX
        local newY = state.startPosition.Y.Offset + deltaY
        newX, newY = clampPosition(button, newX, newY)

        button.Position = UDim2.new(0, newX, 0, newY)
    end
end)

UIS.TouchEnded:Connect(function()
    if dragState and dragState.isTouch then
        finishDrag()
    end
end)

UIS.InputEnded:Connect(function(input)
    if dragState
        and not dragState.isTouch
        and input.UserInputType == Enum.UserInputType.MouseButton1 then
        finishDrag()
    end
end)

-- =========================================================
-- PLAYER SELECTION
-- =========================================================

local function updateStatus()
    if selectedPlayer and selectedPlayer.Parent == Players then
        statusLabel.Text = "TARGET: " .. selectedPlayer.DisplayName
    else
        statusLabel.Text = "SELECT A PLAYER"
    end
end

local function selectPlayer(player)
    selectedPlayer = player
    updateStatus()
end

local function rebuildPlayerList()
    for _, child in ipairs(playerList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local sortedPlayers = Players:GetPlayers()
    table.sort(sortedPlayers, function(a, b)
        return a.DisplayName:lower() < b.DisplayName:lower()
    end)

    for index, player in ipairs(sortedPlayers) do
        local row = Instance.new("TextButton")
        row.Name = "Player_" .. player.UserId
        row.Size = UDim2.new(1, -2, 0, 42)
        row.BackgroundColor3 = player == selectedPlayer
            and Color3.fromRGB(75, 55, 15) or Color3.fromRGB(31, 31, 40)
        row.BorderSizePixel = 0
        row.Text = ""
        row.LayoutOrder = index
        row.Active = true
        row.Selectable = false
        row.Parent = playerList
        corner(row, 6)

        local avatar = Instance.new("ImageLabel")
        avatar.Size = UDim2.new(0, 32, 0, 32)
        avatar.Position = UDim2.new(0, 5, 0, 5)
        avatar.BackgroundTransparency = 1
        avatar.Parent = row
        corner(avatar, 6)

        task.spawn(function()
            local success, image = pcall(function()
                return Players:GetUserThumbnailAsync(
                    player.UserId,
                    Enum.ThumbnailType.HeadShot,
                    Enum.ThumbnailSize.Size100x100
                )
            end)

            if success and avatar.Parent then
                avatar.Image = image
            end
        end)

        local name = Instance.new("TextLabel")
        name.Size = UDim2.new(1, -45, 1, 0)
        name.Position = UDim2.new(0, 42, 0, 0)
        name.BackgroundTransparency = 1
        name.Text = player.DisplayName
        name.Font = Enum.Font.GothamBold
        name.TextSize = 11
        name.TextColor3 = WHITE
        name.TextXAlignment = Enum.TextXAlignment.Left
        name.TextTruncate = Enum.TextTruncate.AtEnd
        name.Parent = row

        row.Activated:Connect(function()
            selectPlayer(player)
            rebuildPlayerList()
        end)
    end

    if selectedPlayer and selectedPlayer.Parent ~= Players then
        selectedPlayer = nil
        updateStatus()
    end
end

Players.PlayerAdded:Connect(rebuildPlayerList)
Players.PlayerRemoving:Connect(function(player)
    if selectedPlayer == player then
        selectedPlayer = nil
        cameraLocked = false
        following = false
        cameraButton.Text = "CAM LOCK: OFF"
        followButton.Text = "START MOVE"
        updateStatus()
    end
    rebuildPlayerList()
end)

-- =========================================================
-- SPEED
-- =========================================================

local function getHumanoid()
    local character = LocalPlayer.Character
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function setSpeed(value)
    selectedSpeed = math.clamp(value, 25, 500)
    speedDisplay.Text = tostring(selectedSpeed)

    local humanoid = getHumanoid()
    if humanoid then
        if originalWalkSpeed == nil then
            originalWalkSpeed = humanoid.WalkSpeed
        end
        humanoid.WalkSpeed = selectedSpeed
    end
end

minusButton.Activated:Connect(function()
    setSpeed(selectedSpeed - 25)
end)

plusButton.Activated:Connect(function()
    setSpeed(selectedSpeed + 25)
end)

LocalPlayer.CharacterAdded:Connect(function(character)
    originalWalkSpeed = nil

    task.wait(0.5)

    if destroyed then
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        originalWalkSpeed = humanoid.WalkSpeed
        humanoid.WalkSpeed = selectedSpeed
    end
end)

-- =========================================================
-- CAMERA LOCK
-- Aims the current camera at the target while keeping its position.
-- =========================================================

local function setCameraLock(enabled)
    cameraLocked = enabled

    local camera = workspace.CurrentCamera
    if enabled then
        if not selectedPlayer then
            cameraLocked = false
            statusLabel.Text = "SELECT A PLAYER FIRST"
            return
        end

        if camera then
            savedCameraType = camera.CameraType
            savedCameraSubject = camera.CameraSubject
        end

        cameraButton.Text = "CAM LOCK: ON"
        cameraButton.BackgroundColor3 = Color3.fromRGB(70, 50, 10)
    else
        if camera then
            if savedCameraType then
                camera.CameraType = savedCameraType
            end
            if savedCameraSubject and savedCameraSubject.Parent then
                camera.CameraSubject = savedCameraSubject
            end
        end

        cameraButton.Text = "CAM LOCK: OFF"
        cameraButton.BackgroundColor3 = DARK
    end
end

cameraButton.Activated:Connect(function()
    if suppressActivation[cameraButton] then
        return
    end
    setCameraLock(not cameraLocked)
end)

-- =========================================================
-- FOLLOW TARGET
-- Smoothly follows behind the selected player's character in 3D.
-- =========================================================

followButton.Activated:Connect(function()
    if suppressActivation[followButton] then
        return
    end

    if not selectedPlayer then
        statusLabel.Text = "SELECT A PLAYER FIRST"
        return
    end

    following = not following

    if following then
        followButton.Text = "STOP MOVE"
        followButton.BackgroundColor3 = Color3.fromRGB(70, 50, 10)
    else
        followButton.Text = "START MOVE"
        followButton.BackgroundColor3 = DARK
    end
end)

-- =========================================================
-- LOOP NOCLIP
-- Client-side only. Server scripts may override character physics.
-- =========================================================

local function setNoclip(enabled)
    noclipEnabled = enabled

    if enabled then
        noclipButton.Text = "LOOP NOCLIP: ON"
        noclipButton.BackgroundColor3 = Color3.fromRGB(70, 50, 10)
    else
        noclipButton.Text = "LOOP NOCLIP: OFF"
        noclipButton.BackgroundColor3 = DARK

        for part, wasCollidable in pairs(originalCollisions) do
            if part and part.Parent then
                part.CanCollide = wasCollidable
            end
        end
        table.clear(originalCollisions)
    end
end

noclipButton.Activated:Connect(function()
    setNoclip(not noclipEnabled)
end)

