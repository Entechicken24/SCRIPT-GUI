	s.Thickness = 1.3
	s.Parent = obj
end

local function button(parent, text, size, pos)
	local b = Instance.new("TextButton")
	b.Size = size
	b.Position = pos
	b.BackgroundColor3 = DARK
	b.TextColor3 = GOLD
	b.Text = text
	b.TextSize = 13
	b.Font = Enum.Font.GothamBold
	b.BorderSizePixel = 0
	b.Active = true
	b.Parent = parent
	round(b)
	stroke(b)
	return b
end

