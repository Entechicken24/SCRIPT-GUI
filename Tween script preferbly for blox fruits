-- CAMERA AIM LOCK
local function stopAimLock()
    if not aimEnabled then
        return
    end

    aimEnabled = false
    RunService:UnbindFromRenderStep(CAMERA_BIND)

    local camera = workspace.CurrentCamera

    if camera then
        camera.CameraType =
            savedCameraType or Enum.CameraType.Custom

        local _, humanoid = getParts(Me)

        if humanoid then
            camera.CameraSubject = humanoid
        elseif savedCameraSubject
            and savedCameraSubject.Parent then
            camera.CameraSubject = savedCameraSubject
        end

        if savedCameraCFrame then
            camera.CFrame = savedCameraCFrame
        end
    end

    savedCameraType = nil
    savedCameraSubject = nil
    savedCameraCFrame = nil

    cameraPosition = nil
    cameraLook = nil

    aimButton.Text = "◎  AIM LOCK: OFF"
    aimButton.TextColor3 = WHITE
end

local function startAimLock()
    if not selected or selected == Me then
        status.Text = "Select another player first"
        return
    end

    local camera = workspace.CurrentCamera
    if not camera then
        status.Text = "Camera unavailable"
        return
    end

    if aimEnabled then
        return
    end

    savedCameraType = camera.CameraType
    savedCameraSubject = camera.CameraSubject
    savedCameraCFrame = camera.CFrame

    cameraPosition = camera.CFrame.Position
    cameraLook = camera.CFrame.LookVector
    currentDistance = desiredDistance

    aimEnabled = true

    aimButton.Text = "◎  AIM LOCK: ON"
    aimButton.TextColor3 = CYAN

    camera.CameraType = Enum.CameraType.Scriptable

    RunService:BindToRenderStep(
        CAMERA_BIND,
        Enum.RenderPriority.Camera.Value + 1,
        function(dt)
            if not aimEnabled then
                return
            end

            local currentCamera = workspace.CurrentCamera
            if not currentCamera then
                return
            end

            local _, _, targetRoot = getParts(selected)
            local _, _, myRoot = getParts(Me)

            if not targetRoot or not myRoot then
                return
            end

            currentCamera.CameraType = Enum.CameraType.Scriptable

            local alpha = 1 - math.exp(-10 * dt)
            currentDistance +=
                (desiredDistance - currentDistance) * alpha

            local desiredPosition =
                myRoot.Position
                - myRoot.CFrame.LookVector * currentDistance
                + Vector3.new(0, CAMERA_HEIGHT, 0)

            local aimPoint =
                targetRoot.Position
                + Vector3.new(0, AIM_HEIGHT, 0)

            local direction = aimPoint - desiredPosition
            if direction.Magnitude < 0.001 then
                return
            end

            cameraPosition = cameraPosition:Lerp(
                desiredPosition,
                1 - math.exp(-14 * dt)
            )

            cameraLook = cameraLook:Lerp(
                direction.Unit,
                1 - math.exp(-20 * dt)
            )

            if cameraLook.Magnitude > 0.001 then
                currentCamera.CFrame = CFrame.lookAt(
                    cameraPosition,
                    cameraPosition + cameraLook.Unit
                )
            end
        end
    )

    status.Text = "Aim locked: " .. selected.DisplayName
end

-- TWEEN
local function stopTween()
    tweenEnabled = false

    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end

    if tweenConnection then
        tweenConnection:Disconnect()
        tweenConnection = nil
    end

    tweenButton.Text = "⚡  START TWEEN"
    tweenButton.TextColor3 = WHITE
end

local function startTween()
    if not selected or selected == Me then
        status.Text = "Select another player first"
        return
    end

    local _, _, myRoot = getParts(Me)
    local _, _, targetRoot = getParts(selected)

    if not myRoot or not targetRoot then
        status.Text = "A character isn't ready"
        return
    end

    stopTween()

    -- In your own game, use a server-authorized movement
    -- system for reliable replicated character movement.
    -- This client tween is intended for local prototypes.

    local goal =
        targetRoot.Position
        - targetRoot.CFrame.LookVector * FOLLOW_DISTANCE

    local distance = (goal - myRoot.Position).Magnitude
    local duration = math.clamp(distance / 40, 0.25, 5)

    tweenEnabled = true
    tweenButton.Text = "⚡  TWEENING..."
    tweenButton.TextColor3 = CYAN

    activeTween = TweenService:Create(
        myRoot,
        TweenInfo.new(
            duration,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            CFrame = CFrame.lookAt(
                goal,
                targetRoot.Position
            )
        }
    )

    local thisTween = activeTween

    tweenConnection = thisTween.Completed:Connect(function()
        if activeTween ~= thisTween then
            return
        end

        activeTween = nil
        tweenEnabled = false

        if tweenConnection then
            tweenConnection:Disconnect()
            tweenConnection = nil
        end

        tweenButton.Text = "⚡  START TWEEN"
        tweenButton.TextColor3 = WHITE
        status.Text = "Tween finished"
    end)

    thisTween:Play()
    status.Text = "Tweening toward " .. selected.DisplayName
end

-- FOLLOW
local function stopFollow()
    followEnabled = false

    if followConnection then
        followConnection:Disconnect()
        followConnection = nil
    end

    local _, humanoid = getParts(Me)

    if humanoid and originalAutoRotate ~= nil then
        humanoid.AutoRotate = originalAutoRotate
    end

    controlledHumanoid = nil
    originalAutoRotate = nil

    followButton.Text = "▶  FOLLOW: OFF"
    followButton.TextColor3 = WHITE
end

local function startFollow()
    if not selected or selected == Me then
        status.Text = "Select another player first"
        return
    end

    local _, humanoid, root = getParts(Me)
    local _, _, targetRoot = getParts(selected)

    if not humanoid or not root or not targetRoot then
        status.Text = "A character isn't ready"
        return
    end

    stopFollow()

    followEnabled = true
    controlledHumanoid = humanoid
    originalAutoRotate = humanoid.AutoRotate

    followButton.Text = "■  FOLLOW: ON"
    followButton.TextColor3 = GREEN

    followConnection = RunService.Heartbeat:Connect(function()
        if not followEnabled then
            return
        end

        local _, currentHumanoid, currentRoot = getParts(Me)
        local _, _, currentTarget = getParts(selected)

        if not currentHumanoid or not currentRoot
            or not currentTarget then
            return
        end

        -- Walk toward a point behind the target using
        -- the normal Humanoid movement controller.
        local goal = currentTarget.Position
            - currentTarget.CFrame.LookVector * FOLLOW_DISTANCE

        local delta = goal - currentRoot.Position

        if delta.Magnitude > 1.5 then
            currentHumanoid:Move(
                Vector3.new(delta.X, 0, delta.Z).Magnitude > 0
                    and Vector3.new(delta.X, 0, delta.Z).Unit
                    or Vector3.zero,
                false
            )
        else
            currentHumanoid:Move(Vector3.zero, false)
        end
    end)

    status.Text = "Following: " .. selected.DisplayName
end

-- PLAYER LIST
local function refreshPlayers()
    for _, child in ipairs(playerList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    table.clear(playerButtons)

    local others = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Me then
            table.insert(others, player)
        end
    end

    table.sort(others, function(a, b)
        return a.Name:lower() < b.Name:lower()
    end)

    for index, player in ipairs(others) do
        local isSelected = player == selected

        local b = create("TextButton", {
            Name = string.format("%03d_Player", index),
            Size = UDim2.new(1, -4, 0, 32),
            BackgroundColor3 = isSelected
                and Color3.fromRGB(60, 45, 105)
                or CARD,
            Text = "◇  " .. player.Name
                .. "  (@" .. player.DisplayName .. ")",
            TextColor3 = WHITE,
            Font = Enum.Font.GothamMedium,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 13
        }, playerList)

        round(b, 7)
        outline(b, isSelected and CYAN or PURPLE, 1)

        playerButtons[player] = b

        b.Activated:Connect(function()
            if followEnabled or tweenEnabled then
                status.Text = "Stop Follow/Tween before switching"
                return
            end

            selected = player
            refreshPlayers()
            status.Text = "Selected: " .. player.DisplayName
        end)
    end
end

