-- Robust mouse/touch dragging for floating controls.
-- Drag position is calculated in screen pixels, then clamped to the viewport.
local function makeDraggable(button)
	local dragging = false
	local dragInput = nil
	local startInputPosition = nil
	local startButtonPosition = nil
	local movedEnough = false
	local suppressNextActivation = false
	local activeTouchId = nil

	button.AnchorPoint = Vector2.new(0, 0)

	local function clampPosition(x, y)
		local camera = workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
		local size = button.AbsoluteSize

		x = math.clamp(x, 0, math.max(0, viewport.X - size.X))
		y = math.clamp(y, 0, math.max(0, viewport.Y - size.Y))

		return x, y
	end

	local function updateDrag(input)
		if not dragging or not startInputPosition or not startButtonPosition then
			return
		end

		local delta = input.Position - startInputPosition
		if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
			movedEnough = true
		end

		local x = startButtonPosition.X + delta.X
		local y = startButtonPosition.Y + delta.Y
		x, y = clampPosition(x, y)

		button.Position = UDim2.fromOffset(x, y)
	end

	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			movedEnough = false
			dragInput = input
			startInputPosition = input.Position
			startButtonPosition = Vector2.new(
				button.AbsolutePosition.X,
				button.AbsolutePosition.Y
			)

			if input.UserInputType == Enum.UserInputType.Touch then
				activeTouchId = input.TouchId
			else
				activeTouchId = nil
			end
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if not dragging then
			return
		end

		if dragInput
			and input == dragInput
			and input.UserInputType == Enum.UserInputType.Touch then
			updateDrag(input)
		elseif input.UserInputType == Enum.UserInputType.MouseMovement
			and dragInput
			and dragInput.UserInputType == Enum.UserInputType.MouseButton1 then
			updateDrag(input)
		elseif input.UserInputType == Enum.UserInputType.Touch
			and activeTouchId ~= nil
			and input.TouchId == activeTouchId then
			updateDrag(input)
		end
	end)

	UIS.InputEnded:Connect(function(input)
		local endingMouse = input.UserInputType == Enum.UserInputType.MouseButton1
		local endingTouch = input.UserInputType == Enum.UserInputType.Touch
			and activeTouchId ~= nil
			and input.TouchId == activeTouchId

		if dragging and (endingMouse or endingTouch) then
			dragging = false
			dragInput = nil
			activeTouchId = nil

			if movedEnough then
				suppressNextActivation = true
				task.delay(0.3, function()
					suppressNextActivation = false
				end)
			end
		end
	end)

	-- Return a safe click handler that ignores the tap at the end of a drag.
	return function()
		if suppressNextActivation then
			suppressNextActivation = false
			return false
		end
		return true
	end
end

