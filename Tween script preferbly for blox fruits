local function stopLoop()
    loopEnabled = false
    loopGeneration += 1

    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end

    loopButton.Text = "START LOOP TWEEN"
    loopButton.BackgroundColor3 = C.Gold
    loopButton.TextColor3 = C.Background
    status.Text = "●  SYSTEM READY"
    status.TextColor3 = C.Green
end

local function startLoop()
    if not selectedPlayer or selectedPlayer == LocalPlayer then
        status.Text = "●  SELECT A TARGET FIRST"
        status.TextColor3 = C.Red
        return
    end

    if not getRoot(LocalPlayer) or not getRoot(selectedPlayer) then
        status.Text = "●  CHARACTER NOT READY"
        status.TextColor3 = C.Red
        return
    end

    loopEnabled = true
    loopGeneration += 1
    local generation = loopGeneration

    loopButton.Text = "STOP LOOP TWEEN"
    loopButton.BackgroundColor3 = C.Red
    loopButton.TextColor3 = C.White
    status.Text = "●  MOVEMENT ACTIVE"
    status.TextColor3 = C.BrightGold

    task.spawn(function()
        while loopEnabled and loopGeneration == generation do
            local myRoot = getRoot(LocalPlayer)
            local targetRoot = getRoot(selectedPlayer)
            local humanoid = getHumanoid(LocalPlayer)

            if not myRoot or not targetRoot or not humanoid
                or humanoid.Health <= 0 then
                status.Text = "●  CHARACTER NOT READY"
                status.TextColor3 = C.Red
                break
            end

            local destinationPosition =
                targetRoot.Position
                - targetRoot.CFrame.LookVector * FOLLOW_DISTANCE

            local distance = (destinationPosition - myRoot.Position).Magnitude

            if distance < 0.5 then
                task.wait(0.1)
            else
                -- Duration is calculated from distance / SPS.
                -- This keeps the configured movement speed consistent.
                local duration = distance / tweenSpeed

                activeTween = TweenService:Create(
                    myRoot,
                    TweenInfo.new(
                        duration,
                        Enum.EasingStyle.Linear,
                        Enum.EasingDirection.Out
                    ),
                    {
                        CFrame = CFrame.lookAt(
                            destinationPosition,
                            targetRoot.Position
                        )
                    }
                )

                activeTween:Play()
                activeTween.Completed:Wait()
                activeTween = nil

                task.wait(0.05)
            end
        end

        if loopGeneration == generation then
            stopLoop()
        end
    end)
end

loopButton.Activated:Connect(function()
    if loopEnabled then
        stopLoop()
    else
        startLoop()
    end
end)

