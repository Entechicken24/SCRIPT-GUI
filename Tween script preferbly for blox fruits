    b.Parent = parent
    round(b)
    outline(b)
    return b
end

-- Dragging works with mouse or touch.
-- Drag only begins on the button itself.
local function makeDraggable(object)
    local dragging = false
    local dragInput
    local startInputPosition
    local startObjectPosition
    local moved = false

    object.Active = true

    object.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            moved = false
            startInputPosition = input.Position
            startObjectPosition = object.Position
            dragInput = input

            local endConnection
            endConnection = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if endConnection then
                        endConnection:Disconnect()
                    end
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if not dragging then return end

        local isMouseMove =
            input.UserInputType == Enum.UserInputType.MouseMovement
        local isTouchMove =
            input.UserInputType == Enum.UserInputType.Touch
            and dragInput == input

        if isMouseMove or isTouchMove then
            local delta = input.Position - startInputPosition

            if math.abs(delta.X) + math.abs(delta.Y) > 6 then
                moved = true
            end

            object.Position = UDim2.new(
                startObjectPosition.X.Scale,
                startObjectPosition.X.Offset + delta.X,
                startObjectPosition.Y.Scale,
                startObjectPosition.Y.Offset + delta.Y
            )
        end
    end)

    return function()
        return moved
    end
end

