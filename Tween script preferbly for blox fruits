--==================================================

local function setStatus(message)
    statusLabel.Text = "READY  /  " .. message
end

local function getParts(player)
    if not player or not player.Character then
        return nil, nil, nil
    end

    local character = player.Character
    return character,
        character:FindFirstChildOfClass("Humanoid"),
        character:FindFirstChild("HumanoidRootPart")
end

local function localParts()
    return getParts(Me)
end

local function targetRoot()
    local _, _, root = getParts(targetPlayer)
    return root
end

local function validTarget()
    if not targetPlayer then
        setStatus("Select a player first.")
        return false
    end

    if targetPlayer == Me then
        setStatus("Select another player.")
        return false
    end

    if not targetPlayer.Parent or not targetRoot() then
        setStatus("Target character not ready.")
        return false
    end

    return true
end

local function refreshSelectedLabel()
    selectedLabel.Text = targetPlayer
        and ("TARGET  /  " .. targetPlayer.DisplayName)
        or "TARGET  /  NONE"
end

--==================================================
-- PLAYER SELECTOR
--==================================================

local function refreshPlayers()
    for _, b in ipairs(playerButtons) do
        if b.Parent then
            b:Destroy()
        end
    end
    table.clear(playerButtons)

    local empty = playerList:FindFirstChild("EmptyMessage")
    if empty then
        empty:Destroy()
    end

    local list = Players:GetPlayers()

    table.sort(list, function(a, b)
        return a.DisplayName:lower() < b.DisplayName:lower()
    end)

    local order = 0

    for _, player in ipairs(list) do
        if player ~= Me then
            order += 1

            local chosen = player == targetPlayer
            local b = button(
                playerList,
                player.DisplayName,
                UDim2.new(),
                UDim2.new(1, -3, 0, 30),
                chosen and Theme.Purple or Theme.Cyan
            )

            b.Name = "Player_" .. player.UserId
            b.LayoutOrder = order
            b.TextXAlignment = Enum.TextXAlignment.Left
            b.Text = "   " .. player.DisplayName .. "  @" .. player.Name
            b.TextSize = 11

            b.Activated:Connect(function()
                if followOn or aimOn or loopTweenOn then
                    setStatus("Stop active controls to change target.")
                    return
                end

                targetPlayer = player
                refreshSelectedLabel()
                refreshPlayers()
                setStatus("Target selected.")
            end)

            table.insert(playerButtons, b)
        end
    end

    if order == 0 then
        label(
            playerList, "No other players found.",
            UDim2.new(0, 7, 0, 5),
            UDim2.new(1, -14, 0, 25),
            11, Theme.Muted
        ).Name = "EmptyMessage"
    end

    refreshSelectedLabel()
end

--==================================================
-- FOLLOW
--==================================================

local function stopFollow(message)
    followOn = false

    if followConnection then
        followConnection:Disconnect()
        followConnection = nil
    end

    followButton.Text = "START FOLLOW"
    if message then
        setStatus(message)
    end
end

local function startFollow()
    if not validTarget() then
        return
    end

    followOn = true
    followButton.Text = "STOP FOLLOW"
    setStatus("Following " .. targetPlayer.DisplayName .. ".")

    if followConnection then
        followConnection:Disconnect()
    end

    followConnection = RunService.Heartbeat:Connect(function()
        if not followOn then
            return
        end

        if not targetPlayer or not targetPlayer.Parent then
            stopFollow("Target unavailable.")
            return
        end

        local _, humanoid, root = localParts()
        local _, _, target = getParts(targetPlayer)

        if not humanoid or not root or not target then
            return
        end

        local goal = target.Position
            - target.CFrame.LookVector * FOLLOW_DISTANCE

        local delta = Vector3.new(
            goal.X - root.Position.X,
            0,
            goal.Z - root.Position.Z
        )

        if delta.Magnitude > FOLLOW_STOP_DISTANCE then
            humanoid:Move(delta.Unit, false)
        else
            humanoid:Move(Vector3.zero, false)
        end
    end)
end

followButton.Activated:Connect(function()
    if followOn then
        stopFollow("Follow stopped.")
    else
        startFollow()
    end
end)

--==================================================
-- AIM LOCK
--==================================================

local function stopAim(message)
    aimOn = false

    if aimConnection then
        aimConnection:Disconnect()
        aimConnection = nil
    end

    local camera = workspace.CurrentCamera

    if camera then
        camera.CameraType = savedCameraType or Enum.CameraType.Custom

        if savedCameraSubject and savedCameraSubject.Parent then
            camera.CameraSubject = savedCameraSubject
        else
            local _, humanoid = localParts()
            if humanoid then
                camera.CameraSubject = humanoid
            end
        end

        if savedCameraCFrame then
            camera.CFrame = savedCameraCFrame
        end
    end

    floatingAim.Text = "AIM LOCK  /  OFF"

    if message then
        setStatus(message)
    end
end

local function startAim()
    if not validTarget() then
        return
    end

    local camera = workspace.CurrentCamera
    if not camera then
        setStatus("Camera unavailable.")
        return
    end

    savedCameraType = camera.CameraType
    savedCameraSubject = camera.CameraSubject
    savedCameraCFrame = camera.CFrame

    aimOn = true
    camera.CameraType = Enum.CameraType.Scriptable

    floatingAim.Text = "AIM LOCK  /  ON"
    setStatus("Aim Lock tracking target.")

    if aimConnection then
        aimConnection:Disconnect()
    end

    aimConnection = RunService.RenderStepped:Connect(function()
        if not aimOn then
            return
        end

        if not targetPlayer or not targetPlayer.Parent then
            stopAim("Target unavailable.")
            return
        end

        local cameraNow = workspace.CurrentCamera
        local _, _, ownRoot = localParts()
        local _, targetHumanoid, enemyRoot = getParts(targetPlayer)

        if not cameraNow or not ownRoot or not targetHumanoid or not enemyRoot then
            return
        end

        cameraNow.CameraType = Enum.CameraType.Scriptable

        local focus = enemyRoot.Position + Vector3.new(0, 2, 0)
        local position = ownRoot.Position
            - ownRoot.CFrame.LookVector * zoomDistance
            + Vector3.new(0, 3, 0)

        cameraNow.CFrame = CFrame.lookAt(position, focus)
    end)
end

floatingAim.Activated:Connect(function()
    if aimOn then
        stopAim("Aim Lock stopped.")
    else
        startAim()
    end
end)

--==================================================
-- LOOP TWEEN
-- Recalculates the destination every cycle.
-- STOP TWEEN cancels the active tween and ends the loop.
--==================================================

local function stopLoopTween(message)
    loopTweenOn = false
    loopId += 1

    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end

    floatingTween.Text = "LOOP TWEEN  /  OFF"

    if message then
        setStatus(message)
    end
end

local function startLoopTween()
    if loopTweenOn then
        return
    end

    if not validTarget() then
        return
    end

    loopTweenOn = true
    loopId += 1

    local thisLoop = loopId

    floatingTween.Text = "LOOP TWEEN  /  ON"
    setStatus("Loop Tween running.")

    task.spawn(function()
        while loopTweenOn and thisLoop == loopId do
            if not targetPlayer or not targetPlayer.Parent then
                stopLoopTween("Target unavailable.")
                return
            end

            local _, _, ownRoot = localParts()
            local _, _, enemyRoot = getParts(targetPlayer)

            if ownRoot and enemyRoot then
                local goal = enemyRoot.Position
                    - enemyRoot.CFrame.LookVector * TWEEN_DISTANCE

                local destination = CFrame.lookAt(
                    Vector3.new(goal.X, ownRoot.Position.Y, goal.Z),
                    Vector3.new(
                        enemyRoot.Position.X,
                        ownRoot.Position.Y,
                        enemyRoot.Position.Z
                    )
                )

                local tween = TweenService:Create(
                    ownRoot,
                    TweenInfo.new(
                        TWEEN_DURATION,
                        Enum.EasingStyle.Quad,
                        Enum.EasingDirection.Out
                    ),
                    { CFrame = destination }
                )

                activeTween = tween
                tween:Play()

                local result = tween.Completed:Wait()

                if activeTween == tween then
                    activeTween = nil
                end

                if not loopTweenOn or thisLoop ~= loopId then
                    return
                end

                if result ~= Enum.PlaybackState.Completed then
                    task.wait(LOOP_DELAY)
                end
            else
                task.wait(0.2)
            end

            if loopTweenOn and thisLoop == loopId then
                task.wait(LOOP_DELAY)
            end
        end
    end)
end

floatingTween.Activated:Connect(function()
    if loopTweenOn then
        stopLoopTween("Loop Tween paused.")
    else
        startLoopTween()
    end
end)

floatingStop.Activated:Connect(function()
    if loopTweenOn then
        stopLoopTween("Loop Tween stopped.")
    else
        setStatus("No active tween.")
    end
end)

--==================================================
-- ZOOM
--==================================================

local function updateZoomText()
    zoomValue.Text = tostring(zoomDistance) .. " studs"
end

zoomMinus.Activated:Connect(function()
    zoomDistance = math.clamp(zoomDistance - 2, MIN_ZOOM, MAX_ZOOM)
    updateZoomText()
end)

zoomPlus.Activated:Connect(function()
    zoomDistance = math.clamp(zoomDistance + 2, MIN_ZOOM, MAX_ZOOM)
    updateZoomText()
end)

