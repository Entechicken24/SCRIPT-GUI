--// DESTROY GUI CLEANUP

local function destroyEverything()
	if destroyed then
		return
	end
	destroyed = true

	setFollow(false)
	setCameraLock(false)
	setNoclip(false)

	pcall(function()
		RunService:UnbindFromRenderStep("NeonCyberCameraLock")
	end)

	for _, connection in ipairs(connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(connections)

	if gui then
		gui:Destroy()
	end
end

track(destroyButton.Activated:Connect(destroyEverything))

