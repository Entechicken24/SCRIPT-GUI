	if targetPlayer == plr then
		targetPlayer = nil
		targetLabel.Text = "TARGET: NONE"
		if following then stopFollow() end
		if cameraLocked then stopCamera() end
	end
	refreshPlayers()
end)

player.CharacterAdded:Connect(function()
	if following then stopFollow() end
	if cameraLocked then stopCamera() end
	if noclip then
		task.wait(0.5)
		if player.Character then applyNoclip(player.Character) end
	end
end)

refreshPlayers()
updateSpeed()
