    local mainText = enabled and "◎  AIMBOT (CAM LOCK): ON" or "◎  AIMBOT (CAM LOCK): OFF"
    local floatText = enabled and "◎ AIMBOT: ON" or "◎ AIMBOT: OFF"
    local color = enabled and GREEN or CYAN

