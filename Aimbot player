        if btnStroke then btnStroke.Color = GREEN end
    else
        selectPartButton.Text = "🎯 SELECT PART (CLICK)"
        selectPartButton.TextColor3 = CYAN
        if btnStroke then btnStroke.Color = CYAN end
    end
end

local function updateSelectedDisplay()
    if selectedPart and selectedPart.Parent then
        selectedDisplay.Text = "  > [PART] " .. selectedPart.Name
        selectedDisplay.TextColor3 = GREEN
    elseif selectedTeam and selectedTeam.Parent == Teams then
        local teamColor = selectedTeam.TeamColor.Color
        if selectedPlayer and selectedPlayer.Parent == Players then
            selectedDisplay.Text = "  > [" .. selectedTeam.Name:upper() .. "] " .. selectedPlayer.DisplayName
        else
            selectedDisplay.Text = "  > [" .. selectedTeam.Name:upper() .. "] SCANNING..."
        end
        selectedDisplay.TextColor3 = teamColor
    elseif selectedPlayer and selectedPlayer.Parent == Players then
        local prefix = nearestMode and "  > [NEAREST] " or "  > "
        selectedDisplay.Text = prefix .. selectedPlayer.DisplayName .. " (@" .. selectedPlayer.Name .. ")"
        selectedDisplay.TextColor3 = nearestMode and GOLD or GREEN
    else
        selectedPlayer = nil
        selectedPart = nil
        selectedTeam = nil
        nearestMode = false
        selectedDisplay.Text = "  NO TARGET LOCKED"
        selectedDisplay.TextColor3 = MUTED
    end

    updateSelectPartButton()
    updateHighlight()
end

refreshRoster = function()
    for _, child in ipairs(roster:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    rosterButtons = {}
    local currentOrder = 0

    --// 1. NEAREST TARGET ENTRY
    if searchQuery == "" or ("nearest"):find(searchQuery:lower()) then
        local nearestButton = button(roster, "  ★ NEAREST TARGET", UDim2.new(1, -6, 0, 27), UDim2.new(), GOLD)
        nearestButton.LayoutOrder = currentOrder
        currentOrder += 1
        nearestButton.TextXAlignment = Enum.TextXAlignment.Left
        nearestButton.BackgroundColor3 = (nearestMode and not selectedTeam) and Color3.fromRGB(80, 58, 12) or GOLD_DARK

        local nearestOutline = nearestButton:FindFirstChildOfClass("UIStroke")
        if nearestOutline then
            nearestOutline.Color = GOLD
            nearestOutline.Transparency = 0
        end

        nearestButton.MouseEnter:Connect(function() if nearestButton.Parent then nearestButton.BackgroundColor3 = Color3.fromRGB(80, 58, 12) end end)
        nearestButton.MouseLeave:Connect(function()
            if nearestButton.Parent then
                nearestButton.BackgroundColor3 = (nearestMode and not selectedTeam) and Color3.fromRGB(80, 58, 12) or GOLD_DARK
            end
        end)

        nearestButton.Activated:Connect(function()
            selectedPart = nil
            selectedTeam = nil
            partSelectArmed = false
            nearestMode = true
            selectedPlayer = findNearestPlayer()
            updateSelectedDisplay()
            refreshRoster()

            if selectedPlayer then
                statusText.Text = "TARGET LOCKED: NEAREST"
                statusText.TextColor3 = GOLD
            else
                statusText.Text = "NO VALID PLAYERS FOUND"
                statusText.TextColor3 = RED
            end
        end)
    end

    --// 2. INDIVIDUAL PLAYERS LIST
    local playerList = Players:GetPlayers()
    table.sort(playerList, function(a, b)
        return a.DisplayName:lower() < b.DisplayName:lower()
    end)

    for _, targetPlayer in ipairs(playerList) do
        if targetPlayer ~= LocalPlayer then
            local displayName = targetPlayer.DisplayName
            local userName = targetPlayer.Name
            local fullTextString = (displayName .. " (@" .. userName .. ")"):lower()

            if searchQuery == "" or fullTextString:find(searchQuery:lower()) then
                local isSelected = (targetPlayer == selectedPlayer and not nearestMode and not selectedPart and not selectedTeam)

                local entry = button(roster, "", UDim2.new(1, -6, 0, 27), UDim2.new(), isSelected and GREEN or CYAN)
                entry.LayoutOrder = currentOrder
                currentOrder += 1
                rosterButtons[targetPlayer] = entry

                make("ImageLabel", {
                    Size = UDim2.fromOffset(21, 21),
                    Position = UDim2.fromOffset(4, 3),
                    BackgroundColor3 = BG,
                    BorderSizePixel = 0,
                    Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(targetPlayer.UserId) .. "&w=48&h=48",
                }, entry)

                make("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -32, 1, 0),
                    Position = UDim2.fromOffset(30, 0),
                    Font = Enum.Font.Code,
                    TextSize = 11,
                    TextColor3 = isSelected and GREEN or WHITE,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = Enum.TextYAlignment.Center,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    Text = displayName .. " (@" .. userName .. ")",
                }, entry)

                entry.Activated:Connect(function()
                    selectedPart = nil
                    selectedTeam = nil
                    partSelectArmed = false
                    nearestMode = false
                    selectedPlayer = targetPlayer
                    updateSelectedDisplay()
                    refreshRoster()
                end)

                if isSelected then
                    entry.BackgroundColor3 = Color3.fromRGB(15, 55, 50)
                end
            end
        end
    end

    --// 3. TEAMS AT THE BOTTOM OF THE LIST
    local gameTeams = Teams:GetTeams()
    table.sort(gameTeams, function(a, b)
        return a.Name:lower() < b.Name:lower()
    end)

    for _, team in ipairs(gameTeams) do
        local teamSearchString = ("team " .. team.Name):lower()
        if searchQuery == "" or teamSearchString:find(searchQuery:lower()) then
            local isTeamSelected = (selectedTeam == team)
            local teamColor = team.TeamColor.Color

            local teamBtn = button(roster, "", UDim2.new(1, -6, 0, 27), UDim2.new(), teamColor)
            teamBtn.LayoutOrder = currentOrder
            currentOrder += 1

            local teamOutline = teamBtn:FindFirstChildOfClass("UIStroke")
            if teamOutline then
                teamOutline.Color = teamColor
                teamOutline.Transparency = isTeamSelected and 0 or 0.35
            end

            -- Team color badge
            local colorBadge = make("Frame", {
                Size = UDim2.fromOffset(10, 10),
                Position = UDim2.fromOffset(8, 8),
                BackgroundColor3 = teamColor,
                BorderSizePixel = 0,
            }, teamBtn)
            round(colorBadge, 3)

            make("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -28, 1, 0),
                Position = UDim2.fromOffset(24, 0),
                Font = Enum.Font.Code,
                TextSize = 11,
                TextColor3 = isTeamSelected and GREEN or teamColor,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Center,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Text = "⚑ TEAM: " .. team.Name:upper(),
            }, teamBtn)

            local defaultBg = isTeamSelected and Color3.fromRGB(18, 45, 55) or PANEL_LIGHT
            teamBtn.BackgroundColor3 = defaultBg

            teamBtn.MouseEnter:Connect(function() if teamBtn.Parent then teamBtn.BackgroundColor3 = Color3.fromRGB(25, 55, 75) end end)
            teamBtn.MouseLeave:Connect(function() if teamBtn.Parent then teamBtn.BackgroundColor3 = defaultBg end end)

            teamBtn.Activated:Connect(function()
                selectedPart = nil
                partSelectArmed = false
                nearestMode = true
                selectedTeam = team
                selectedPlayer = findNearestPlayer(team)
                updateSelectedDisplay()
                refreshRoster()

                if selectedPlayer then
                    statusText.Text = "TEAM LOCK: " .. team.Name:upper()
                    statusText.TextColor3 = teamColor
                else
                    statusText.Text = "NO ALIVE TARGETS ON " .. team.Name:upper()
                    statusText.TextColor3 = GOLD
                end
            end)
        end
    end

    updateSelectedDisplay()
end

