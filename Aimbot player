local function findNearestPlayer(teamFilter)
    local localRoot = getRoot(LocalPlayer)
    if not localRoot then return nil end

    local nearestPlayer = nil
    local shortestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not teamFilter or player.Team == teamFilter then
                local root = getRoot(player)
                local humanoid = getHumanoid(player)

                if root and humanoid and humanoid.Health > 0 then
                    local distance = (root.Position - localRoot.Position).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        nearestPlayer = player
                    end
                end
            end
        end
    end

    return nearestPlayer
end

--// HIGHLIGHT MANAGEMENT
local function clearHighlight()
    if targetHighlight then
        targetHighlight:Destroy()
        targetHighlight = nil
    end
end

local function updateHighlight()
    local adornee = nil
    local highlightColor = GREEN

    if selectedPart and selectedPart.Parent then
        adornee = selectedPart
        highlightColor = GREEN
    else
        local targetChar = getCharacter(selectedPlayer)
        if targetChar then
            adornee = targetChar
            if selectedTeam then
                highlightColor = selectedTeam.TeamColor.Color
            elseif nearestMode then
                highlightColor = GOLD
            else
                highlightColor = GREEN
            end
        end
    end

    if not adornee or destroyed then
        clearHighlight()
        return
    end

    if targetHighlight and targetHighlight.Adornee == adornee then
        targetHighlight.FillColor = highlightColor
        targetHighlight.OutlineColor = highlightColor
        return
    end

    clearHighlight()

    targetHighlight = Instance.new("Highlight")
    targetHighlight.Name = "NeonTargetHighlight"
    targetHighlight.FillColor = highlightColor
    targetHighlight.FillTransparency = 0.65
    targetHighlight.OutlineColor = highlightColor
    targetHighlight.OutlineTransparency = 0
    targetHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    targetHighlight.Adornee = adornee
    targetHighlight.Parent = adornee
end

local function updateSelectPartButton()
