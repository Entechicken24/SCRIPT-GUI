--// MAIN RENDER LOOP (AIMBOT + AUTO GRAB TOGGLE + NEAREST/TEAM SYNC)
RunService:BindToRenderStep(
    "NeonCyberControlCenterUpdate",
    Enum.RenderPriority.Camera.Value + 1,
    function()
        if destroyed then return end

        --// GRAB TOGGLE AUTOMATION CHECK
        if grabToggleEnabled then
            local grabFolder = workspace:FindFirstChild("GrabParts")
            local holdingSomething = grabFolder and #grabFolder:GetChildren() > 0

            if holdingSomething and not isCurrentlyGrabbed then
                isCurrentlyGrabbed = true
                wasCamLockBeforeGrab = camLockEnabled
                if camLockEnabled then
                    setCamLock(false)
                end
            elseif not holdingSomething and isCurrentlyGrabbed then
                isCurrentlyGrabbed = false
                if wasCamLockBeforeGrab then
                    setCamLock(true)
                end
            end
        end

        if nearestMode and not selectedPart then
            local nearest = findNearestPlayer(selectedTeam)
            if nearest ~= selectedPlayer then
                selectedPlayer = nearest
                updateSelectedDisplay()
            end
        end

        updateHighlight()

        local targetPart = getTargetPart(selectedPlayer)
        if camLockEnabled and targetPart then
            local camera = getCamera()
            if camera then
                camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetPart.Position)
            end
        end
    end
)

local function toggleMinimize()
    minimized = not minimized
    main.Visible = not minimized
    openGuiButton.Text = minimized and "SHOW GUI" or "HIDE GUI"
end

minimizeButton.Activated:Connect(toggleMinimize)
closeButton.Activated:Connect(toggleMinimize)
openGuiButton.Activated:Connect(toggleMinimize)

table.insert(globalConnections, UserInputService.InputBegan:Connect(function(input, processed)
