-- Geschwindigkeit
local moveSpeed = 1
local minimumSpeed = 1
local maximumSpeed = inf

local function updateSpeedLabel()
	speedLabel.Text = "Speed: " .. moveSpeed
end

plus.MouseButton1Click:Connect(function()
	if moveSpeed < maximumSpeed then
		moveSpeed += 1
		updateSpeedLabel()
	end
end)

minus.MouseButton1Click:Connect(function()
	if moveSpeed > minimumSpeed then
		moveSpeed -= 1
		updateSpeedLabel()
	end
end)

-- UP
local tis

up.MouseButton1Down:Connect(function()
	tis = up.MouseEnter:Connect(function()
		while tis do
			task.wait()

			local char = game.Players.LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")

			if root then
				root.CFrame = root.CFrame * CFrame.new(0, moveSpeed, 0)
			end
		end
	end)
end)

up.MouseLeave:Connect(function()
	if tis then
		tis:Disconnect()
		tis = nil
	end
end)

-- DOWN
local dis

down.MouseButton1Down:Connect(function()
	dis = down.MouseEnter:Connect(function()
		while dis do
			task.wait()

			local char = game.Players.LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")

			if root then
				root.CFrame = root.CFrame * CFrame.new(0, -moveSpeed, 0)
			end
		end
	end)
end)

down.MouseLeave:Connect(function()
	if dis then
		dis:Disconnect()
		dis = nil
	end
end)

-- FORWARD
local movingForward = false

forward.MouseButton1Down:Connect(function()
	movingForward = true

	while movingForward do
		task.wait()

		local char = game.Players.LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local camera = workspace.CurrentCamera

		if root and camera then
			root.CFrame = root.CFrame + camera.CFrame.LookVector * moveSpeed
		end
	end
end)

forward.MouseButton1Up:Connect(function()
	movingForward = false
end)

forward.MouseLeave:Connect(function()
	movingForward = false
end)

-- X / SCHLIESSEN
closebutton.MouseButton1Click:Connect(function()
	main:Destroy()
end)

